<Project Sdk="Microsoft.NET.Sdk">

  <!--
      Casos de uso e portas.

      Depende de Domain e Contracts, e de mais nada concreto. Não conhece EF
      Core, Docker nem HTTP — quem conhece é a Infrastructure, que implementa
      as interfaces declaradas aqui.

      A dependência aponta para dentro: Infrastructure → Application → Domain.
      Nunca o contrário.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
  </ItemGroup>

  <!--
      O hash do token de recuperação é internal de propósito: ninguém fora daqui
      deve produzi-lo. O teste precisa dele para montar um cenário de token
      expirado sem esperar uma hora, e é o único de fora que enxerga.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="TCMine.Server.Application.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\server\TCMine.Server.Domain\TCMine.Server.Domain.csproj"/>
    <ProjectReference Include="..\..\shared\TCMine.Contracts\TCMine.Contracts.csproj"/>
  </ItemGroup>

</Project>
