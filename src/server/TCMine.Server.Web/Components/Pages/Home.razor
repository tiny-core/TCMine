@page "/admin"
@using TCMine.Contracts.Servers

<PageTitle>Visão geral — TCMine</PageTitle>

<PageHeader Title="Visão geral"
            Subtitle="O que está no ar agora e o que espera por você."
            Icon="@Icons.Material.Filled.SpaceDashboard">
    <MudButton Href="/admin/modpacks" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile">
        Importar modpack
    </MudButton>
    <MudButton Href="/admin/modpacks" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
        Novo modpack
    </MudButton>
</PageHeader>

@if (_isLoading)
{
    <LoadingCards Count="4"/>
}
else
{
    <section class="tc-kpis tc-fade-in" aria-label="Indicadores">
        <MudPaper Outlined="true" Class="tc-kpi">
            <span class="tc-kpi-label"><MudIcon Icon="@Icons.Material.Filled.SportsEsports" Size="Size.Small"/>Jogadores online</span>
            @* Traço quando nenhum servidor no ar foi amostrado: zero afirmaria
               que estão vazios, e não se sabe. *@
            <span class="tc-kpi-value">@(PlayersOnline?.ToString() ?? "—")</span>
            <span class="tc-kpi-caption">
                em @RunningServers.Count @(RunningServers.Count == 1 ? "servidor no ar" : "servidores no ar")
                @if (PeakToday is { } pico)
                {
                    <text> · pico de @pico hoje</text>
                }
            </span>
        </MudPaper>

        <MudPaper Outlined="true" Class="tc-kpi">
            <span class="tc-kpi-label"><MudIcon Icon="@Icons.Material.Filled.Dns" Size="Size.Small"/>Servidores</span>
            <span class="tc-kpi-value">@RunningServers.Count <small>de @_servers.Count no ar</small></span>
            <span class="tc-kpi-caption">
                @if (CrashedServers.Count > 0)
                {
                    <span class="tc-text-danger">@CrashedServers.Count caiu</span>
                }
                else
                {
                    <span>nenhum caído</span>
                }
            </span>
        </MudPaper>

        <MudPaper Outlined="true" Class="tc-kpi">
            <span class="tc-kpi-label"><MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small"/>Modpacks</span>
            <span class="tc-kpi-value">@_packs.Count</span>
            <span class="tc-kpi-caption">@_packs.Count(p => p.Published is not null) publicados · @_packs.Count(p => p.Draft is not null) com rascunho</span>
        </MudPaper>

        <MudPaper Outlined="true" Class="tc-kpi">
            <span class="tc-kpi-label"><MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small"/>Disco</span>
            @if (_disk is { } disk)
            {
                <span class="tc-kpi-value">@disk.UsedPercent.ToString("0")<small>%</small></span>
                <MudProgressLinear Value="@disk.UsedPercent" Rounded="true" Size="Size.Small"
                                   Color="@(disk.UsedPercent >= 85 ? Color.Error : Color.Primary)"/>
                <span class="tc-kpi-caption">@HumanSize.Bytes(disk.UsedBytes) de @HumanSize.Bytes(disk.TotalBytes)</span>
            }
            else
            {
                <span class="tc-kpi-value">—</span>
                <span class="tc-kpi-caption">aguardando a primeira medição</span>
            }
        </MudPaper>
    </section>

    <div class="tc-cols">
        <MudPaper Outlined="true" Class="tc-panel">
            <div class="tc-panel-head">
                <MudText Typo="Typo.h6">Servidores</MudText>
                <MudButton Href="/admin/servers" Variant="Variant.Text" Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowForward">
                    Ver todos
                </MudButton>
            </div>

            @if (_servers.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Filled.Dns"
                            Title="Nenhum servidor ainda."
                            Description="Crie um a partir de uma versão publicada de um modpack."/>
            }

            @foreach (var server in _servers)
            {
                var metric = LastMetric(server.Id);
                var players = Players.TryGet(server.Id);

                <div class="tc-server-row">
                    <div class="tc-server-name">
                        <span class="tc-crystal @CrystalClass(server.Status)" aria-hidden="true"></span>
                        <div>
                            <div class="tc-strong">@server.Name</div>
                            <div class="tc-caption">@PackName(server.ModpackId) · v@(VersionNumber(server.ModpackVersionId))</div>
                        </div>
                    </div>

                    @if (server.Status is GameServerStatus.Running && metric is not null)
                    {
                        <div class="tc-meter">
                            <span>CPU @metric.CpuPercent.ToString("0")%</span>
                            <MudProgressLinear Value="@Math.Min(100, metric.CpuPercent)" Size="Size.Small" Rounded="true" Color="Color.Primary"/>
                        </div>
                        <div class="tc-meter">
                            <span>RAM @HumanSize.Bytes(metric.MemoryUsedBytes) de @HumanSize.Bytes(metric.MemoryLimitBytes)</span>
                            <MudProgressLinear Value="@MemoryPercent(metric)" Size="Size.Small" Rounded="true" Color="Color.Primary"/>
                        </div>
                    }
                    else
                    {
                        <div class="tc-caption tc-span-2">@StatusHint(server.Status)</div>
                    }

                    <div class="tc-server-actions">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                 Color="@(server.Status is GameServerStatus.Running ? Color.Success : Color.Default)">
                            @(players?.ToString() ?? "—") / @server.MaxPlayers
                        </MudChip>
                        <MudButton Href="@ServerHref(server)" Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Terminal">
                            Abrir
                        </MudButton>
                    </div>
                </div>
            }
        </MudPaper>

        <MudStack Spacing="4">
            <MudPaper Outlined="true" Class="tc-panel">
                <div class="tc-panel-head">
                    <MudText Typo="Typo.h6">Precisa da sua atenção</MudText>
                </div>

                @if (_attention.Count == 0)
                {
                    <div class="tc-attention">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success"/>
                        <div class="tc-attention-body">
                            <div>Nada pendente.</div>
                            <div class="tc-caption">Pedidos de acesso, quedas e versões com falha aparecem aqui.</div>
                        </div>
                    </div>
                }

                @foreach (var item in _attention)
                {
                    <div class="tc-attention">
                        <MudIcon Icon="@item.Icon" Color="@(item.Danger ? Color.Error : Color.Warning)"/>
                        <div class="tc-attention-body">
                            <div>@item.Title</div>
                            <div class="tc-caption">@item.Detail</div>
                        </div>
                        <MudButton Href="@item.Href" Variant="Variant.Outlined" Size="Size.Small">@item.Action</MudButton>
                    </div>
                }
            </MudPaper>

            <MudPaper Outlined="true" Class="tc-panel">
                <div class="tc-panel-head">
                    <MudText Typo="Typo.h6">Atividade recente</MudText>
                </div>

                @if (_recentActivity.Count == 0)
                {
                    <div class="tc-attention">
                        <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Default"/>
                        <div class="tc-attention-body">
                            <div>Nada ainda.</div>
                            <div class="tc-caption">Login no painel, versão publicada, servidor caído e backup aparecem aqui.</div>
                        </div>
                    </div>
                }

                @foreach (var entry in _recentActivity)
                {
                    <div class="tc-attention">
                        <MudIcon Icon="@ActivityIcon(entry.Kind)" Color="@ActivityColor(entry.Kind)"/>
                        <div class="tc-attention-body">
                            <div>@entry.Message</div>
                            <div class="tc-caption">@RelativeTime.From(entry.CreatedAt)</div>
                        </div>
                        @if (entry.Href is { Length: > 0 } href)
                        {
                            <MudButton Href="@href" Variant="Variant.Text" Size="Size.Small">Ver</MudButton>
                        }
                    </div>
                }
            </MudPaper>
        </MudStack>
    </div>

    <div class="my-4">
        <MetricsPanel/>
    </div>

    <MudPaper Outlined="true" Class="tc-panel">
        <div class="tc-panel-head">
            <MudText Typo="Typo.h6">Modpacks</MudText>
            <MudButton Href="/admin/modpacks" Variant="Variant.Text" Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowForward">
                Ver todos
            </MudButton>
        </div>

        @if (_packs.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Filled.Inventory2"
                        Title="Nenhum modpack ainda."
                        Description="Crie o primeiro para começar a distribuir aos jogadores.">
                <MudButton Href="/admin/modpacks" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add">
                    Ir para Modpacks
                </MudButton>
            </EmptyState>
        }
        else
        {
            <MudSimpleTable Dense="false" Hover="true" Elevation="0" Class="tc-table">
                <thead>
                <tr>
                    <th>Modpack</th>
                    <th>Minecraft</th>
                    <th>Versão publicada</th>
                    <th>Estado</th>
                    <th>Servidores</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var pack in _packs)
                {
                    <tr>
                        <td><a href="@($"/admin/modpacks/{pack.Modpack.Id}")" class="tc-strong">@pack.Modpack.Name</a></td>
                        <td>@pack.Modpack.MinecraftVersion · @pack.Modpack.Loader</td>
                        <td>@(pack.Published is { } v ? $"v{v.Version}" : "—")</td>
                        <td>
                            @if (pack.Published is not null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">publicado</MudChip>
                            }
                            @if (pack.Draft is { } draft)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">v@(draft.Version) @StateLabel(draft.State)</MudChip>
                            }
                        </td>
                        <td>@_servers.Count(s => s.ModpackId == pack.Modpack.Id)</td>
                    </tr>
                }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>
}
