@page "/"

<PageTitle>Painel — TCMine</PageTitle>

<PageHeader Title="Painel"
            Subtitle="Visão geral do seu servidor TCMine."
            Icon="@Icons.Material.Filled.Dashboard"/>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4"/>
}
else
{
    <MudGrid Class="tc-fade-in">
        <StatCard Icon="@Icons.Material.Filled.Inventory2" Label="Modpacks"
                  Value="@_modpacks.Count.ToString()"/>
        <StatCard Icon="@Icons.Material.Filled.Dns" Label="Servidores"
                  Value="@_servers.Count.ToString()"/>
        <StatCard Icon="@Icons.Material.Filled.PlayCircle" Label="Rodando"
                  Value="@RunningServers.ToString()" IconColor="Color.Success"/>
        <StatCard Icon="@Icons.Material.Filled.Hub" Label="Protocolo"
                  Value="@ProtocolVersion.ToString()" IconColor="Color.Info"/>
    </MudGrid>

    <div class="my-4">
        <MetricsPanel/>
    </div>

    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-8 mb-3">
        <MudText Typo="Typo.h6">Modpacks recentes</MudText>
        <MudSpacer/>
        <MudButton Href="/modpacks" Variant="Variant.Text" Color="Color.Primary"
                   EndIcon="@Icons.Material.Filled.ArrowForward">
            Ver todos
        </MudButton>
    </MudStack>

    @if (_modpacks.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.Inventory2"
                    Title="Nenhum modpack ainda."
                    Description="Crie o primeiro para começar a distribuir aos jogadores.">
            <MudButton Href="/modpacks" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add">
                Ir para Modpacks
            </MudButton>
        </EmptyState>
    }
    else
    {
        <MudGrid>
            @foreach (var pack in _modpacks.Take(3))
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Class="tc-card d-flex flex-column" Elevation="2">
                        <MudCardContent Class="flex-grow-1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Rounded="true">
                                    @if (pack.IconUrl is not null)
                                    {
                                        <MudImage Src="@pack.IconUrl.ToString()"/>
                                    }
                                    else
                                    {
                                        @(pack.Name.Length > 0 ? pack.Name[..1].ToUpperInvariant() : "?")
                                    }
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.h6">@pack.Name</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        MC @pack.MinecraftVersion · @pack.Loader
                                    </MudText>
                                </div>
                            </MudStack>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Href="@($"/modpacks/{pack.Id}")" Variant="Variant.Text"
                                       Color="Color.Primary" StartIcon="@Icons.Material.Filled.OpenInNew">
                                Abrir
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
}
