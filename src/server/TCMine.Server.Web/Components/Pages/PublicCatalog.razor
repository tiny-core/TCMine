@page "/"
@attribute [AllowAnonymous]
@layout EmptyLayout
@using TCMine.Contracts.Servers

<PageTitle>TCMine — Modpacks e Servidores</PageTitle>

<div class="tc-public">
    <header class="tc-hero">
        @* A caverna só aqui, sob um véu escuro: o design system a reserva para o
           topo e o login, e sem o véu o texto não respira sobre a pintura. *@
        <img class="tc-hero-bg" src="/images/public/hero-cave.png" alt="" aria-hidden="true"/>
        <div class="tc-hero-veil"></div>

        <div class="tc-wrap">
            <nav class="tc-nav" aria-label="Navegação">
                <a class="tc-brand" href="/">
                    <img src="/images/public/logo-crystal.jpg" alt=""/>
                    <span>TCMine</span>
                </a>
                <a class="tc-nav-link" href="#como-jogar">Como jogar</a>
                <a class="tc-nav-link" href="#modpacks">Modpacks</a>
                <a class="tc-nav-link" href="#servidores">Servidores</a>
                <a class="tc-btn tc-btn-ghost tc-nav-login" href="/admin">Entrar no painel</a>
            </nav>

            <div class="tc-hero-body">
                @if (_launcher is not null)
                {
                    <span class="tc-eyebrow">Launcher v@(_launcher.Version) · entre no servidor com um clique</span>
                }

                <h1>Seus modpacks, <em>prontos para jogar.</em></h1>
                <p class="tc-lead">
                    Baixe o launcher, entre com a sua conta Microsoft e escolha o pack. Mods, configs e
                    atualizações chegam sozinhos — o seu mundo fica intacto.
                </p>

                <div class="tc-actions">
                    @if (_launcher is not null)
                    {
                        <a class="tc-btn tc-btn-primary tc-btn-lg" href="@_launcher.DownloadUrl">Baixar para Windows</a>
                    }
                    else
                    {
                        <span class="tc-muted">O launcher ainda não foi publicado nesta instalação.</span>
                    }
                    <a class="tc-btn tc-btn-lg" href="#modpacks">Ver os modpacks</a>
                </div>

                @if (!_isLoading)
                {
                    <dl class="tc-facts">
                        <div><dt>@_catalog.Modpacks.Count</dt><dd>@(_catalog.Modpacks.Count == 1 ? "modpack" : "modpacks")</dd></div>
                        <div><dt>@OnlineServerCount</dt><dd>@(OnlineServerCount == 1 ? "servidor no ar" : "servidores no ar")</dd></div>
                        <div><dt>@TotalOnline</dt><dd>jogando agora</dd></div>
                    </dl>
                }
            </div>
        </div>
    </header>

    <main class="tc-wrap">
        <section class="tc-section" id="como-jogar" aria-labelledby="como-h">
            <h2 id="como-h">Como jogar</h2>
            <p class="tc-sub">Três passos, e só da primeira vez.</p>
            <ol class="tc-steps">
                <li class="tc-card">
                    <span class="tc-step-n">1</span>
                    <h3>Baixe o launcher</h3>
                    <p>Ele já vem com o endereço deste servidor. Não há nada para configurar.</p>
                </li>
                <li class="tc-card">
                    <span class="tc-step-n">2</span>
                    <h3>Entre com a Microsoft</h3>
                    <p>A mesma conta do Minecraft. A senha fica na página da Microsoft, nunca no launcher.</p>
                </li>
                <li class="tc-card">
                    <span class="tc-step-n">3</span>
                    <h3>Escolha e jogue</h3>
                    <p>Instale um modpack ou clique em Entrar num servidor. Atualizações chegam sozinhas.</p>
                </li>
            </ol>
        </section>

        <section class="tc-section" id="modpacks" aria-labelledby="modpacks-h">
            <h2 id="modpacks-h">Modpacks</h2>
            <p class="tc-sub">Instale pelo launcher; o que muda numa versão nova chega na próxima abertura.</p>

            @if (_isLoading)
            {
                <p class="tc-muted">Carregando…</p>
            }
            else if (_catalog.Modpacks.Count is 0)
            {
                <p class="tc-muted">Nenhum modpack publicado ainda.</p>
            }
            else
            {
                <div class="tc-grid">
                    @foreach (var modpack in _catalog.Modpacks)
                    {
                        <article class="tc-card tc-pack tc-fade-in">
                            <div class="tc-pack-head">
                                <span class="tc-tile">
                                    @if (modpack.IconUrl is not null)
                                    {
                                        <img src="@modpack.IconUrl" alt=""/>
                                    }
                                    else
                                    {
                                        @modpack.Name[..1].ToUpperInvariant()
                                    }
                                </span>
                                <div>
                                    <h3>@modpack.Name</h3>
                                    @if (modpack.OwnerDisplayName is { Length: > 0 } owner)
                                    {
                                        <span class="tc-muted">por @owner</span>
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(modpack.Summary))
                            {
                                <p class="tc-pack-summary">@modpack.Summary</p>
                            }
                            <div class="tc-chips">
                                <span class="tc-chip">Minecraft @modpack.MinecraftVersion</span>
                                <span class="tc-chip">@LoaderLabel(modpack.Loader)</span>
                                @if (ServersOf(modpack.Name) is > 0 and var count)
                                {
                                    <span class="tc-chip tc-chip-on">@count @(count == 1 ? "servidor" : "servidores")</span>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="tc-section" id="servidores" aria-labelledby="servers-h">
            <h2 id="servers-h">Servidores</h2>
            <p class="tc-sub">O endereço aparece no launcher para quem tem acesso. Peça o seu por lá.</p>

            @if (_isLoading)
            {
                <p class="tc-muted">Carregando…</p>
            }
            else if (_catalog.Servers.Count is 0)
            {
                <p class="tc-muted">Nenhum servidor ainda.</p>
            }
            else
            {
                <div class="tc-grid">
                    @foreach (var server in _catalog.Servers)
                    {
                        var online = server.Status is GameServerStatus.Running;

                        <article class="tc-card tc-server tc-fade-in">
                            <div class="tc-server-head">
                                <span class="tc-crystal @(online ? "tc-crystal-on" : "tc-crystal-off")" aria-hidden="true"></span>
                                <h3>@server.Name</h3>
                                <span class="tc-chip @(online ? "tc-chip-on" : "")">@StatusLabel(server.Status)</span>
                            </div>
                            <span class="tc-muted">@server.ModpackName</span>

                            <div class="tc-players">
                                @* Traço quando não se sabe: parado, ou ainda não amostrado. *@
                                <strong>@(online && server.OnlinePlayers is { } n ? n.ToString() : "—")</strong>
                                <span class="tc-muted">de @server.MaxPlayers jogadores</span>
                            </div>
                            <div class="tc-bar" aria-hidden="true"><i style="width: @PlayersPercent(server)%"></i></div>

                            <span class="tc-muted tc-hint">
                                @(online ? "Entre pelo TCMine Launcher" : "Volta quando o administrador ligar")
                            </span>
                        </article>
                    }
                </div>
            }
        </section>

        @if (_launcher is not null)
        {
            <section class="tc-card tc-final" aria-label="Baixar o launcher">
                <img src="/images/public/logo-crystal.jpg" alt=""/>
                <div>
                    <h2>Pronto para entrar?</h2>
                    <p class="tc-sub">Windows 10 ou 11. O instalador já sabe onde fica este servidor.</p>
                </div>
                <a class="tc-btn tc-btn-primary tc-btn-lg" href="@_launcher.DownloadUrl">Baixar o launcher</a>
            </section>
        }

        <footer class="tc-footer">
            <span>TCMine — modpacks e servidores de Minecraft.</span>
            @if (_launcher is not null)
            {
                <span>launcher @_launcher.Version</span>
            }
        </footer>
    </main>
</div>
