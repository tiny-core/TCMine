@page "/setup"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout EmptyLayout

<PageTitle>Primeiro acesso — TCMine</PageTitle>

<AuthShell Title="Primeiro acesso"
           Subtitle="Crie a conta de administrador desta instalação. Esta tela fecha sozinha depois — só existe enquanto não há nenhum usuário."
           Error="@Error">
    <form method="post" action="/auth/setup">
        <AntiforgeryToken/>

        <MudStack Spacing="4">
            <MudTextField T="string" name="displayName" Label="Nome"
                          Variant="Variant.Outlined" Required="true"/>

            <MudTextField T="string" name="email" InputType="InputType.Email"
                          Label="E-mail" Variant="Variant.Outlined" Required="true"/>

            <MudTextField T="string" name="password" InputType="InputType.Password"
                          Label="Senha" Variant="Variant.Outlined" Required="true"
                          HelperText="Mínimo de 8 caracteres."/>

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                       Color="Color.Primary" Size="Size.Large" FullWidth="true">
                Criar administrador
            </MudButton>
        </MudStack>
    </form>
</AuthShell>
