@page "/admin/setup"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout EmptyLayout

<PageTitle>Primeiro acesso — TCMine</PageTitle>

<AuthShell Title="Primeiro acesso"
           Subtitle="Antes de entrar, informe o ID do aplicativo que você registrou no Entra ID para o login com a Microsoft. Esta tela fecha sozinha depois — só existe enquanto não há nenhum usuário."
           Error="@Error">
    <form method="post" action="/auth/setup">
        <AntiforgeryToken/>

        <MudStack Spacing="4">
            <MudTextField T="string" name="azureClientId" Label="ID do aplicativo (cliente)"
                          Variant="Variant.Outlined" Required="true"
                          Placeholder="00000000-0000-0000-0000-000000000000"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Custom.Brands.Microsoft"
                          HelperText="GUID do registro no Entra ID. Pode ser trocado depois, em Configurações."/>

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                       Color="Color.Primary" Size="Size.Large" FullWidth="true">
                Continuar
            </MudButton>
        </MudStack>
    </form>
</AuthShell>
