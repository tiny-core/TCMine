@page "/reset-password"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout EmptyLayout

<PageTitle>Nova senha — TCMine</PageTitle>

<AuthShell Title="Criar nova senha"
           Subtitle="Escolha a senha que vai usar daqui em diante."
           Error="@Error">
    <form method="post" action="/auth/reset-password">
        <AntiforgeryToken/>
        <input type="hidden" name="token" value="@Token"/>

        <MudStack Spacing="4">
            <MudTextField T="string" name="email" InputType="InputType.Email"
                          Label="E-mail" Variant="Variant.Outlined" Required="true"/>

            <MudTextField T="string" name="password" InputType="InputType.Password"
                          Label="Nova senha" Variant="Variant.Outlined" Required="true"
                          HelperText="Mínimo de 8 caracteres."/>

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                       Color="Color.Primary" Size="Size.Large" FullWidth="true">
                Salvar nova senha
            </MudButton>
        </MudStack>
    </form>

    <MudLink Href="/login" Typo="Typo.body2" Class="d-block mt-4">
        Voltar para o login
    </MudLink>
</AuthShell>
