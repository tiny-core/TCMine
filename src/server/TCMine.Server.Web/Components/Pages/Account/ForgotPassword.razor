@page "/forgot-password"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout EmptyLayout

<PageTitle>Recuperar senha — TCMine</PageTitle>

<AuthShell Title="Recuperar senha"
           Subtitle="Informe o e-mail da conta. Se ele estiver cadastrado, enviamos um link para você criar uma nova senha."
           Info="@Info">
    @if (string.IsNullOrEmpty(Info))
    {
        <form method="post" action="/auth/forgot-password">
            <AntiforgeryToken/>

            <MudStack Spacing="4">
                <MudTextField T="string" name="email" InputType="InputType.Email"
                              Label="E-mail" Variant="Variant.Outlined" Required="true"/>

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                           Color="Color.Primary" Size="Size.Large" FullWidth="true">
                    Enviar link
                </MudButton>
            </MudStack>
        </form>
    }

    <MudLink Href="/login" Typo="Typo.body2" Class="d-block mt-4">
        Voltar para o login
    </MudLink>
</AuthShell>
