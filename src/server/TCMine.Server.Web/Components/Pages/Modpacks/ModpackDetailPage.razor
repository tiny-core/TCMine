@page "/modpacks/{ModpackId:guid}"
@using TCMine.Contracts.Modpacks
@using TCMine.Server.Application.Abstractions
@using TCMine.UI.Shared.Formatting
@inject IModpackRepository Repository
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>@(_modpack?.Name ?? "Modpack") — TCMine</PageTitle>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4"/>
}
else if (_modpack is null)
{
    <EmptyState Icon="@Icons.Material.Filled.SearchOff"
                Title="Modpack não encontrado."
                Description="Ele pode ter sido removido."/>
}
else
{
    <ModpackWorkspace Modpack="_modpack" Active="ModpackTab.Overview"
                      SelectedVersionId="_selectedVersionId" SelectedVersion="_selectedVersion"
                      SelectedVersionIdChanged="OnVersionChanged">
        <HeaderActions>
            @if (_modpack.Versions.Count > 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateVersion">
                    Nova versão
                </MudButton>
            }
            @* Ações do modpack em si (não da versão), fora do caminho principal. *@
            <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                     title="Ações do modpack">
                <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="OpenEditModpack">
                    Editar modpack
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                             OnClick="DeleteModpackAsync">
                    Apagar modpack
                </MudMenuItem>
            </MudMenu>
        </HeaderActions>
        <ChildContent>
            @if (_modpack.Versions.Count is 0)
            {
                <EmptyState Icon="@Icons.Material.Filled.Layers"
                            Title="Nenhuma versão ainda."
                            Description="Crie a primeira versão para gerenciar mods e publicar.">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateVersion">
                        Criar versão
                    </MudButton>
                </EmptyState>
            }
            else if (_selectedVersion is not null)
            {
                @* Próximo passo: a ação certa conforme o estado da versão. *@
                <MudAlert Severity="@NextSeverity(_selectedVersion.State)" Variant="Variant.Outlined" Class="mb-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap"
                              Style="width:100%;">
                        <div style="flex:1; min-width:200px;">
                            <MudText Typo="Typo.body1" Style="font-weight:600;">
                                @NextTitle(_selectedVersion.State)
                            </MudText>
                            <MudText Typo="Typo.body2">@NextHint(_selectedVersion.State)</MudText>
                            @if (_selectedVersion.State is ModpackVersionState.Failed
                                 && !string.IsNullOrWhiteSpace(_selectedVersion.FailureReason))
                            {
                                @* O motivo já era gravado mas nunca aparecia: sem ele o
                                   admin não sabe se foi rede, cota da API ou um mod que
                                   proíbe distribuição — e não sabe se adianta reparar. *@
                                <MudText Typo="Typo.caption" Class="d-block mt-1"
                                         Style="opacity:.85; word-break:break-word;">
                                    @_selectedVersion.FailureReason
                                </MudText>
                            }
                        </div>
                        @if (_selectedVersion.State is ModpackVersionState.Draft)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                       Href="@($"/modpacks/{ModpackId}/versions/{_selectedVersion.Id}/mods")"
                                       StartIcon="@Icons.Material.Filled.Add">Adicionar mods
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.Publish"
                                       OnClick="Publish"
                                       Disabled="_isPublishing || SelectedStats.TotalCount == 0">Publicar
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="OpenEditVersion">Editar
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                       OnClick="DeleteVersion">Apagar
                            </MudButton>
                        }
                        else if (_selectedVersion.State is ModpackVersionState.Ready)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                       Href="@($"/modpacks/{ModpackId}/servers")"
                                       StartIcon="@Icons.Material.Filled.Dns">Criar servidor
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.SystemUpdateAlt"
                                       OnClick="OpenCheckUpdates">Verificar atualizações
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.Archive"
                                       OnClick="Archive">Arquivar
                            </MudButton>
                        }
                        else if (_selectedVersion.State is ModpackVersionState.Resolving)
                        {
                            @* Progresso vindo do worker, não da contagem de arquivos:
                               mostra o mod que está sendo baixado agora, e não só
                               "N de M" que só mexe quando um download inteiro acaba. *@
                            <div style="min-width:240px;">
                                @if (Progress is { } p)
                                {
                                    @if (p.IsDeterminate)
                                    {
                                        <MudProgressLinear Color="Color.Info" Value="@p.Percent" Class="mb-1"/>
                                        <MudText Typo="Typo.caption">
                                            @p.Done de @p.Total mods@(p.Dependencies > 0
                                                                        ? $" · +{p.Dependencies} dependências"
                                                                        : "") — @p.Step
                                        </MudText>
                                    }
                                    else
                                    {
                                        <MudProgressLinear Color="Color.Info" Indeterminate="true" Class="mb-1"/>
                                        <MudText Typo="Typo.caption">@p.Step</MudText>
                                    }
                                }
                                else if (_expectedModCount is { } total && total > 0)
                                {
                                    @* Sem job vivo no processo (reiniciou no meio):
                                       cai para a contagem do banco, que é grosseira
                                       mas honesta. *@
                                    <MudProgressLinear Color="Color.Info" Striped="true"
                                                       Value="@(ModCount * 100.0 / total)" Class="mb-1"/>
                                    <MudText Typo="Typo.caption">@ModCount de @total mods</MudText>
                                }
                                else
                                {
                                    <MudProgressLinear Color="Color.Info" Indeterminate="true"/>
                                }
                            </div>
                        }
                        else if (_selectedVersion.State is ModpackVersionState.Failed)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       OnClick="Retry" Disabled="_isRetrying">Tentar novamente
                            </MudButton>
                            @if (_isRetrying)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
                            }
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                       OnClick="DeleteVersion">Apagar
                            </MudButton>
                        }
                        else if (_selectedVersion.State is ModpackVersionState.Archived)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Unarchive"
                                       OnClick="Restore">Restaurar
                            </MudButton>
                        }
                    </MudStack>
                </MudAlert>

                @* O autor publicou um server pack. Não substitui o que o TCMine
                   monta — a instância sai desta versão —, mas é a referência de
                   quais mods ele considera de servidor, e quem vai criar um
                   servidor merece saber que existe. *@
                @if (_selectedVersion.UpstreamServerPackUrl is { Length: > 0 } serverPack)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
                            <div style="flex:1; min-width:240px;">
                                <MudText Typo="Typo.body2">
                                    O autor publica um <b>server pack</b> para esta versão.
                                </MudText>
                                <MudText Typo="Typo.caption">
                                    O servidor criado aqui é montado a partir desta versão e não precisa
                                    dele. Vale para comparar configs ou rodar o servidor oficial ao lado.
                                </MudText>
                            </div>
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.OpenInNew"
                                       Href="@serverPack" Target="_blank">
                                Ver na origem
                            </MudButton>
                        </MudStack>
                    </MudAlert>
                }

                @* Só depois de resolver. Durante a ingestão cada mod do pack
                   tem uma pendência Queued, e o painel listaria o pack inteiro
                   como "aguardando upload manual" — o oposto do que ele quer
                   dizer. *@
                @if (_selectedVersion.State is not ModpackVersionState.Resolving
                     && _selectedVersion.HasManualUploads)
                {
                    <PendingModsPanel Pending="_selectedVersion.ManualUploads"
                                      CanUpload="@(_selectedVersion.State is ModpackVersionState.Draft)"
                                      IsBusy="_isRetrying"
                                      CanUseServerPack="@(_selectedVersion.State is ModpackVersionState.Draft
                                                          && _selectedVersion.UpstreamServerPackFileId is { Length: > 0 })"
                                      IsCompleting="_isCompleting"
                                      OnCompleteFromServerPack="CompleteFromServerPack"
                                      OnUpload="UploadForPending"
                                      OnRetry="Retry"/>
                }

                <MudGrid Class="mb-2">
                    <StatCard Icon="@Icons.Material.Filled.Extension" Label="Mods"
                              Value="@ModCount.ToString()"/>
                    <StatCard Icon="@Icons.Material.Filled.Folder" Label="Overrides"
                              Value="@OverrideCount.ToString()"/>
                    <StatCard Icon="@Icons.Material.Filled.Storage" Label="Tamanho total"
                              Value="@HumanSize.Bytes(TotalSizeBytes)"/>
                    <StatCard Icon="@Icons.Material.Filled.Dns" Label="Servidores"
                              Value="@_serverCount.ToString()" IconColor="Color.Info"/>
                </MudGrid>

                <MudGrid>
                    <MudItem xs="12" md="7">
                        <MudPaper Class="pa-5" Elevation="2">
                            <MudText Typo="Typo.subtitle1" Class="mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2"
                                         Style="vertical-align:middle;"/>
                                Linha do tempo de versões
                            </MudText>
                            <MudStack Spacing="3">
                                @foreach (var v in _modpack.Versions.OrderByDescending(v => v.Id))
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudText Typo="Typo.body1"
                                                 Style="@(v.Id == _selectedVersionId ? "font-weight:700;" : "")">
                                            @v.Version
                                        </MudText>
                                        <VersionStateChip State="v.State"/>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @FileCountOf(v.Id) arquivo(s)
                                        </MudText>
                                        @if (v.Id != _selectedVersionId)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                                       OnClick="@(() => OnVersionChanged(v.Id))">
                                                Selecionar
                                            </MudButton>
                                        }
                                    </MudStack>
                                }
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="5">
                        <MudPaper Class="pa-5" Elevation="2">
                            <MudText Typo="Typo.subtitle1" Class="mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2"
                                         Style="vertical-align:middle;"/>
                                Detalhes da versão
                            </MudText>
                            <MudStack Spacing="0">
                                <div class="tc-kv"><span>Minecraft</span><b>@_modpack.MinecraftVersion</b></div>
                                <div class="tc-kv">
                                    <span>Loader</span><b>@_modpack.Loader @_selectedVersion.LoaderVersion</b></div>
                                <div class="tc-kv">
                                    <span>RAM recomendada</span>
                                    <b>@(_selectedVersion.RecommendedMemoryMb is { } r ? $"{r} MB" : "—")</b>
                                </div>
                                <div class="tc-kv">
                                    <span>Origem</span>
                                    @if (_modpack.UpstreamProvider is { } origem)
                                    {
                                        @* Link direto para o projeto lá fora: é para
                                           onde o admin vai quando precisa baixar um mod
                                           bloqueado ou conferir o changelog do autor. *@
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                                 Color="Color.Info" Icon="@Icons.Material.Filled.CloudDownload"
                                                 Href="@UpstreamUrl" Target="_blank">
                                            @origem
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <b>Criado aqui</b>
                                    }
                                </div>

                                @if (_selectedVersion.UpstreamVersionLabel is { Length: > 0 } autorLabel)
                                {
                                    @* A numeração do autor é outra coisa da nossa: "1.0.0" é
                                       nossa, "4.2" é dele. Mostrar as duas evita o admin achar
                                       que publicou a versão errada. *@
                                    <div class="tc-kv">
                                        <span>Versão do autor</span>
                                        @if (_upstream is { HasUpdate: true } atualizacao)
                                        {
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <b>@autorLabel</b>
                                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                                                         Size="Size.Small" Color="Color.Warning"/>
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                                         Variant="Variant.Filled">
                                                    @atualizacao.LatestLabel
                                                </MudChip>
                                                <MudTooltip Text="Traz a atualização do autor para um rascunho novo, preservando o que você mudou">
                                                    <MudIconButton Icon="@Icons.Material.Filled.SystemUpdateAlt"
                                                                   Size="Size.Small" Color="Color.Warning"
                                                                   OnClick="OpenUpstreamUpdate"/>
                                                </MudTooltip>
                                            </MudStack>
                                        }
                                        else
                                        {
                                            <b>@autorLabel</b>
                                        }
                                    </div>
                                }

                                <div class="tc-kv">
                                    <span>Canal</span>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                             Color="@(_selectedVersion.IsPreRelease ? Color.Warning : Color.Primary)">
                                        @(_selectedVersion.IsPreRelease ? "pré-lançamento" : "release")
                                    </MudChip>
                                </div>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            }
        </ChildContent>
    </ModpackWorkspace>
}
