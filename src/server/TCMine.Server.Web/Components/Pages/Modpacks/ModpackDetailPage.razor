@page "/modpacks/{ModpackId:guid}"
@using TCMine.Contracts.Modpacks
@using TCMine.Server.Application.Abstractions
@inject IModpackRepository Repository
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>@(_modpack?.Name ?? "Modpack") — TCMine</PageTitle>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4"/>
}
else if (_modpack is null)
{
    <EmptyState Icon="@Icons.Material.Filled.SearchOff"
                Title="Modpack não encontrado."
                Description="Ele pode ter sido removido."/>
}
else
{
    <PageHeader Title="@_modpack.Name"
                Subtitle="@($"MC {_modpack.MinecraftVersion} · {_modpack.Loader}")"
                Icon="@Icons.Material.Filled.Inventory2"
                Breadcrumbs="_breadcrumbs">
        @if (_modpack.Versions.Count > 0)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateVersion">
                Nova versão
            </MudButton>
        }
    </PageHeader>

    @if (_modpack.Versions.Count is 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.Layers"
                    Title="Nenhuma versão ainda."
                    Description="Crie a primeira versão para gerenciar mods e publicar.">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateVersion">
                Criar versão
            </MudButton>
        </EmptyState>
    }
    else
    {
        @* Barra da versão selecionada: seletor + estado + ações de rascunho.
           Os cards abaixo operam sobre a versão escolhida aqui. *@
        <MudPaper Class="pa-4 mb-4 tc-fade-in" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
                <MudSelect T="Guid" Value="_selectedVersionId"
                           ValueChanged="OnVersionChanged"
                           Label="Versão" Variant="Variant.Outlined"
                           Dense="true" Style="max-width: 220px;">
                    @foreach (var v in _modpack.Versions)
                    {
                        <MudSelectItem Value="v.Id">@v.Version (@v.State)</MudSelectItem>
                    }
                </MudSelect>

                @if (_selectedVersion is not null)
                {
                    <VersionStateChip State="_selectedVersion.State"/>
                    <MudChip T="string" Icon="@Icons.Material.Filled.Build"
                             Size="Size.Small" Variant="Variant.Text">
                        @_modpack.Loader @_selectedVersion.LoaderVersion
                    </MudChip>
                    @if (_selectedVersion.RecommendedMemoryMb is { } ram)
                    {
                        <MudChip T="string" Icon="@Icons.Material.Filled.Memory"
                                 Size="Size.Small" Variant="Variant.Text">
                            @ram MB
                        </MudChip>
                    }
                }

                <MudSpacer/>

                @if (_selectedVersion?.State is ModpackVersionState.Draft)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Publish"
                               OnClick="Publish"
                               Disabled="_isPublishing || _selectedVersion.Files.Count == 0">
                        @if (_isPublishing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                        }
                        Publicar
                    </MudButton>
                    <MudTooltip Text="Editar versão">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="OpenEditVersion"/>
                    </MudTooltip>
                    <MudTooltip Text="Apagar rascunho">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                       Size="Size.Small" OnClick="DeleteVersion"/>
                    </MudTooltip>
                }
            </MudStack>
        </MudPaper>

        @* Cards de gerenciamento. Cada um abre uma tela/diálogo específico. *@
        <MudGrid Class="tc-fade-in">
            <ManagementCard Icon="@Icons.Material.Filled.Extension"
                            Title="@($"{ModCount} mod(s)")"
                            Description="Mods do cliente e do servidor."
                            OnManage="OpenMods"/>

            <ManagementCard Icon="@Icons.Material.Filled.Folder"
                            Title="@($"{OverrideCount} override(s)")"
                            Description="Configs e arquivos extras."
                            OnManage="OpenOverrides"/>

            <ManagementCard Icon="@Icons.Material.Filled.Campaign"
                            Title="Novidades"
                            Description="Posts exibidos no launcher."
                            OnManage="OpenNews"/>

            <ManagementCard Icon="@Icons.Material.Filled.Dns"
                            Title="Servidores"
                            Description="Instâncias derivadas deste modpack."
                            OnManage="OpenServers"/>
        </MudGrid>
    }
}
