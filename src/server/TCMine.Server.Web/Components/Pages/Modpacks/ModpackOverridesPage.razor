@page "/modpacks/{ModpackId:guid}/versions/{VersionId:guid}/overrides"
@using TCMine.Contracts.Modpacks
@using TCMine.UI.Shared.Formatting

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4"/>
}
else if (_modpack is null || _version is null)
{
    <EmptyState Icon="@Icons.Material.Filled.SearchOff" Title="Versão não encontrada."/>
}
else
{
    <ModpackWorkspace Modpack="_modpack" Active="ModpackTab.Overrides"
                      SelectedVersionId="VersionId" SelectedVersion="_version"
                      SelectedVersionIdChanged="OnVersionChanged">
        <HeaderActions>
            @if (_version.State is ModpackVersionState.Draft)
            {
                <MudButton StartIcon="@Icons.Material.Filled.Undo" OnClick="Undo"
                           Disabled="@(!UndoService.HasUndo(VersionId))">
                    Desfazer
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.NoteAdd"
                           OnClick="OpenNewFile">
                    Novo arquivo
                </MudButton>
            }
        </HeaderActions>
        <ChildContent>

            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudPaper Outlined="true" Class="pa-2" Style="height: 70vh; overflow: auto;"
                              @ondragover:preventDefault="true"
                              @ondrop="@(() => OnDropRoot())">
                        @if (_treeItems.Count == 0)
                        {
                            <MudText Class="pa-2" Color="Color.Secondary">Nenhum override ainda.</MudText>
                        }
                        else
                        {
                            @* ServerData: os filhos de uma pasta só existem quando
                               ela é aberta. Sem isto, um pack importado montava os
                               3380 overrides como componentes de uma vez — a página
                               levava dezenas de segundos e o circuito engasgava. *@
                            <MudTreeView T="string" Items="_treeItems" ServerData="LoadChildrenAsync"
                                         SelectedValue="_selectedPath" SelectedValueChanged="OnSelect"
                                         Hover="true" Dense="true"
                                         @key="_treeRevision">
                                <ItemTemplate Context="node">
                                    <MudTreeViewItem T="string" Value="@node.Value"
                                                     Items="@node.Children" CanExpand="@node.Expandable"
                                                     Icon="@node.Icon">
                                        <BodyContent>
                                            <div class="d-flex align-center flex-grow-1" style="min-width:0;"
                                                 @ondragover:preventDefault="true"
                                                 @ondrop="@(() => OnDrop(node.Value))">
                                                <MudText Class="flex-grow-1 text-truncate" Style="cursor:pointer"
                                                         @onclick="@(() => OnSelect(node.Value))">
                                                    @node.Text
                                                </MudText>
                                                @if (_version?.State is ModpackVersionState.Draft)
                                                {
                                                    <span draggable="true" style="cursor:grab; padding:0 4px;"
                                                          @ondragstart="@(() => _dragPath = node.Value)"
                                                          @ondragend="@(() =>
                                                                      {
                                                                          _dragPath = null;
                                                                          _dropTarget = null;
                                                                      })">
                                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                                                         Size="Size.Small" Color="Color.Default"/>
                                            </span>
                                                }
                                            </div>
                                        </BodyContent>
                                    </MudTreeViewItem>
                                </ItemTemplate>
                            </MudTreeView>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                        <MudText Typo="Typo.subtitle2">@(_selectedPath ?? "Selecione um arquivo")</MudText>
                        <MudSpacer/>
                        @if (_isOpening)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
                        }
                        @if (_version.State is ModpackVersionState.Draft && _selectedPath is not null)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="Save" Disabled="_isSaving || !_dirty || _notEditable is not null">
                                Salvar
                            </MudButton>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                           Size="Size.Small" OnClick="Delete" Disabled="_isSaving"/>
                        }
                    </MudStack>

                    @if (_notEditable is { } blocked)
                    {
                        @* PNG, .jar e .zip vêm dentro dos overrides de um pack.
                           Despejá-los no Monaco travava a aba — aqui o arquivo
                           continua acessível, só que por download. *@
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
                                <div style="flex:1; min-width:200px;">
                                    <MudText Typo="Typo.body2">@blocked.Reason</MudText>
                                    <MudText Typo="Typo.caption">@HumanSize.Bytes(blocked.SizeBytes)</MudText>
                                </div>
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Download"
                                           Href="@($"/api/v1/blobs/{blocked.Sha256}")" Target="_blank">
                                    Baixar
                                </MudButton>
                            </MudStack>
                        </MudAlert>
                    }

                    <div class="tc-editor-host" style="@(_notEditable is null ? "" : "display:none;")">
                        <StandaloneCodeEditor @ref="_editor"
                                              CssClass="tc-monaco"
                                              ConstructionOptions="EditorOptions"
                                              OnDidInit="OnEditorInit"
                                              OnDidChangeModelContent="@(() => _dirty = true)"/>
                    </div>
                </MudItem>
            </MudGrid>

        </ChildContent>
    </ModpackWorkspace>
}
