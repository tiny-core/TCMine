@page "/modpacks"
@using TCMine.Server.Application.Abstractions
@using TCMine.Server.Application.Modpacks
@inject IModpackRepository Repository
@inject IDialogService DialogService
@inject DeleteModpack DeleteUseCase
@inject ISnackbar Snackbar

<PageTitle>Modpacks — TCMine</PageTitle>

<PageHeader Title="Modpacks"
            Subtitle="Catálogos que você distribui aos jogadores."
            Icon="@Icons.Material.Filled.Inventory2">
    <MudButton Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.CloudSync"
               OnClick="OpenImportDialog">
        Importar
    </MudButton>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog">
        Novo modpack
    </MudButton>
</PageHeader>

@if (_isLoading)
{
    <LoadingCards/>
}
else if (_modpacks.Count is 0)
{
    <EmptyState Icon="@Icons.Material.Filled.Inventory2"
                Title="Nenhum modpack ainda."
                Description="Crie o primeiro para começar a distribuir aos jogadores.">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Criar modpack
        </MudButton>
    </EmptyState>
}
else
{
    <MudGrid Class="tc-fade-in">
        @foreach (var pack in _modpacks)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Class="tc-card d-flex flex-column" Elevation="2">
                    <MudCardContent Class="flex-grow-1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-3">
                            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Rounded="true">
                                @if (pack.IconUrl is not null)
                                {
                                    <MudImage Src="@pack.IconUrl.ToString()"/>
                                }
                                else
                                {
                                    @(pack.Name.Length > 0 ? pack.Name[..1].ToUpperInvariant() : "?")
                                }
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.h6">@pack.Name</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@pack.Slug</MudText>
                            </div>
                        </MudStack>

                        <MudStack Row="true" Spacing="1" Class="mb-2" Wrap="Wrap.Wrap">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                     Icon="@Icons.Material.Filled.Widgets">
                                MC @pack.MinecraftVersion
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">
                                @pack.Loader
                            </MudChip>
                        </MudStack>

                        @if (!string.IsNullOrWhiteSpace(pack.Summary))
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@pack.Summary</MudText>
                        }
                    </MudCardContent>

                    <MudCardActions>
                        <MudButton Href="@($"/modpacks/{pack.Id}")"
                                   Variant="Variant.Text" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.OpenInNew">
                            Abrir
                        </MudButton>
                        <MudSpacer/>
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                                 title="Mais ações">
                            <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                         OnClick="@(() => OpenEditDialog(pack))">
                                Editar
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                                         OnClick="@(() => Delete(pack))">
                                Apagar
                            </MudMenuItem>
                        </MudMenu>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}
