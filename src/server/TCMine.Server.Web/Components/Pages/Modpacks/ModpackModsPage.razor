@page "/modpacks/{ModpackId:guid}/versions/{VersionId:guid}/mods"
@using TCMine.Contracts.Modpacks
@using TCMine.Server.Application.Abstractions
@using TCMine.Server.Application.Modpacks
@using TCMine.Server.Domain.Modpacks
@using TCMine.UI.Shared.Formatting
@inject IModpackRepository Repository
@inject RemoveModpackFile RemoveFileUseCase
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Mods — TCMine</PageTitle>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4"/>
}
else if (_modpack is null || _version is null)
{
    <EmptyState Icon="@Icons.Material.Filled.SearchOff" Title="Versão não encontrada."/>
}
else
{
    <ModpackWorkspace Modpack="_modpack" Active="ModpackTab.Mods"
                      SelectedVersionId="VersionId" SelectedVersion="_version"
                      SelectedVersionIdChanged="OnVersionChanged">
        <HeaderActions>
            @if (_version.State is ModpackVersionState.Draft)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.CloudDownload" OnClick="OpenIngest">
                    Buscar no Modrinth
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Upload" OnClick="OpenManualUpload">
                    Enviar arquivo
                </MudButton>
            }
            else if (_version.State is ModpackVersionState.Ready)
            {
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.SystemUpdateAlt" OnClick="OpenCheckUpdates">
                    Verificar atualizações
                </MudButton>
            }
        </HeaderActions>
        <ChildContent>
            @if (IsIngesting)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2"/>
                @* Mostra o passo real em vez de um texto fixo: com centenas de
                   mods, saber em qual está é o que diz que não travou. *@
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @(Progress is { IsDeterminate: true } p
                        ? $"{p.Step} — {p.Done} de {p.Total}"
                        : Progress?.Step ?? "Processando mods…")
                </MudText>
            }

            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudSpacer/>
                <MudTextField T="string" Value="_searchString" ValueChanged="OnSearchChanged"
                              DebounceInterval="400"
                              Placeholder="Filtrar mods..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Small"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined"
                              Style="max-width: 280px;"/>
            </MudStack>

            @* ServerData: a grade pede uma página por vez. Uma versão importada
               tem centenas de mods, e materializá-los todos no circuito era o que
               fazia a aba demorar a abrir. *@
            <MudDataGrid @ref="_grid" T="ModpackFile"
                         ServerData="LoadPageAsync"
                         Dense="true"
                         Hover="true"
                         Filterable="false"
                         SortMode="SortMode.None"
                         RowsPerPage="25"
                         Elevation="1">
                <Columns>
                    <TemplateColumn Title="" Sortable="false">
                        <CellTemplate>
                            <MudAvatar Size="Size.Small" Variant="Variant.Outlined">
                                @if (!string.IsNullOrEmpty(context.Item.IconUrl))
                                {
                                    <MudImage Src="@context.Item.IconUrl"/>
                                }
                                else
                                {
                                    <MudIcon Icon="@OriginIcon(context.Item.Origin)" Size="Size.Small"/>
                                }
                            </MudAvatar>
                        </CellTemplate>
                    </TemplateColumn>

                    <PropertyColumn Property="f => f.Path" Title="Caminho"/>

                    <TemplateColumn Title="Tamanho">
                        <CellTemplate>
                            @HumanSize.Bytes(context.Item.SizeBytes)
                        </CellTemplate>
                    </TemplateColumn>

                    @* Editável no rascunho. Nenhuma origem responde isto de
                       forma confiável — o manifest do CurseForge não declara
                       lado e o neoforge.mods.toml não tem campo de lado por mod
                       —, então quem sabe é o admin. Errar aqui manda mod de
                       cliente para o container e o servidor não sobe. *@
                    <TemplateColumn Title="Lado">
                        <CellTemplate>
                            @if (_version.State is ModpackVersionState.Draft)
                            {
                                <MudSelect T="FileSide" Value="context.Item.Side" Dense="true"
                                           Margin="Margin.Dense" Variant="Variant.Text"
                                           Disabled="@(_savingSide == context.Item.Id)"
                                           ValueChanged="@(s => ChangeSide(context.Item, s))">
                                    <MudSelectItem Value="FileSide.Both">cliente e servidor</MudSelectItem>
                                    <MudSelectItem Value="FileSide.ClientOnly">só cliente</MudSelectItem>
                                    <MudSelectItem Value="FileSide.ServerOnly">só servidor</MudSelectItem>
                                </MudSelect>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                                    @context.Item.Side
                                </MudChip>
                            }
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="Origem">
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small"
                                     Icon="@OriginIcon(context.Item.Origin)"
                                     Color="@OriginColor(context.Item.Origin)"
                                     Variant="Variant.Text">
                                @context.Item.Origin
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>

                    @if (_version.State is ModpackVersionState.Draft)
                    {
                        <TemplateColumn Title="" Sortable="false">
                            <CellTemplate>
                                <MudTooltip Text="Remover">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   Disabled="IsIngesting"
                                                   OnClick="@(() => RemoveFile(context.Item))"/>
                                </MudTooltip>
                            </CellTemplate>
                        </TemplateColumn>
                    }
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="ModpackFile"/>
                </PagerContent>

                <NoRecordsContent>
                    <MudText Class="pa-4" Color="Color.Secondary">
                        Nenhum mod nesta versão. Use "Buscar no Modrinth" para começar.
                    </MudText>
                </NoRecordsContent>
            </MudDataGrid>
        </ChildContent>
    </ModpackWorkspace>
}
