@page "/caixa-de-teste"

@* O que o TCMine tentou enviar, capturado pelo SMTP de desenvolvimento.

   A página existe mesmo com a caixa desligada, para explicar como ligá-la em
   vez de sumir do menu e deixar a pessoa procurando. *@

<PageTitle>Caixa de teste — TCMine</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap" Spacing="2">
    <div>
        <MudText Typo="Typo.h5">Caixa de teste</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            E-mails capturados no lugar de serem entregues.
        </MudText>
    </div>

    <MudSpacer/>

    @if (Options.Value.Enabled)
    {
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="@(() => StateHasChanged())">
            Atualizar
        </MudButton>

        <MudButton Variant="Variant.Text" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.DeleteSweep"
                   OnClick="Limpar" Disabled="Mailbox.Count == 0">
            Limpar
        </MudButton>
    }
</MudStack>

@if (!Options.Value.Enabled)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        <MudText Typo="Typo.body2">
            A caixa de teste está desligada. Para ligá-la, ponha
            <code>"DevMail": { "Enabled": true }</code> no appsettings e aponte o SMTP das
            Configurações para <b>127.0.0.1</b>, porta <b>@Options.Value.Port</b>, sem TLS.
        </MudText>
        <MudText Typo="Typo.caption" Class="mt-2">
            Ela só aceita conexões da própria máquina e não entrega nada a ninguém —
            serve para conferir o texto e os links das mensagens.
        </MudText>
    </MudAlert>
}
else if (Mailbox.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Filled.MarkEmailUnread"
                Title="Nenhuma mensagem ainda"
                Description="Use o botão de teste nas Configurações, ou peça uma recuperação de senha."/>
}
else
{
    <MudExpansionPanels MultiExpansion="true" Elevation="0">
        @foreach (var email in Mailbox.Recent())
        {
            <MudExpansionPanel>
                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
                        <MudText Typo="Typo.body2"><b>@email.Subject</b></MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">para @email.To</MudText>
                        <MudSpacer/>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @email.ReceivedAt.ToLocalTime().ToString("dd/MM HH:mm:ss")
                        </MudText>
                    </MudStack>
                </TitleContent>
                <ChildContent>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                        De @email.From
                    </MudText>

                    @* Pré-formatado porque o corpo é texto puro e os links de
                       recuperação quebram se a quebra de linha for engolida. *@
                    <MudPaper Class="pa-3" Outlined="true" Elevation="0">
                        <pre style="white-space:pre-wrap; word-break:break-word; margin:0;">@email.Body</pre>
                    </MudPaper>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}
