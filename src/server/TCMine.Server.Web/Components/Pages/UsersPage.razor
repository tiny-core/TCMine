@page "/admin/users"
@using TCMine.Server.Domain.Identity

<PageTitle>Usuários — TCMine</PageTitle>

<PageHeader Title="Usuários"
            Subtitle="Todas as contas desta instalação."
            Icon="@Icons.Material.Filled.Group">
    @if (_isBusy)
    {
        <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
    }
</PageHeader>

@if (!_loaded)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px"/>
}
else if (!_canManage)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        Só o admin da instalação gerencia usuários.
    </MudAlert>
}
else
{
    <MudPaper Outlined="true" Class="tc-panel pa-4 tc-fade-in">
        <MudTextField T="string" @bind-Value="_search" Immediate="true" Label="Buscar por nome"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="mb-3" Style="max-width:360px;"/>

        <MudTable Items="_filtrados" Dense="true" Hover="true" Elevation="0" RowsPerPage="20">
            <HeaderContent>
                <MudTh>Nome</MudTh>
                <MudTh>Tipo de conta</MudTh>
                <MudTh>Admin da instalação</MudTh>
                <MudTh>Visto por último</MudTh>
                <MudTh Style="text-align:right;">Ações</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Nome">@context.DisplayName</MudTd>
                <MudTd DataLabel="Tipo de conta">
                    <MudText Typo="Typo.caption">@TipoDeConta(context)</MudText>
                </MudTd>
                <MudTd DataLabel="Admin da instalação">
                    <MudSwitch T="bool" Value="context.IsInstanceAdmin" Color="Color.Primary"
                               Disabled="_isBusy"
                               ValueChanged="@(ligado => ToggleAdminAsync(context, ligado))"/>
                </MudTd>
                <MudTd DataLabel="Visto por último">
                    <MudText Typo="Typo.caption">
                        @(context.LastSeenAt is { } visto
                            ? visto.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            : "nunca entrou")
                    </MudText>
                </MudTd>
                <MudTd Style="text-align:right;">
                    <MudTooltip Text="Ver vínculos">
                        <MudIconButton Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small"
                                       OnClick="@(() => ShowMembershipsAsync(context))"/>
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}
