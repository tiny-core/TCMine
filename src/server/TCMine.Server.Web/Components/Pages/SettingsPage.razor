@using TCMine.Server.Application.Abstractions
@page "/settings"
@using TCMine.Contracts.Modpacks

<PageTitle>Configurações — TCMine</PageTitle>

<PageHeader Title="Configurações"
            Subtitle="Padrões e integrações desta instalação."
            Icon="@Icons.Material.Filled.Settings">
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Save"
               OnClick="Save" Disabled="_isSaving || _isLoading">
        @if (_isSaving)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
        }
        Salvar
    </MudButton>
</PageHeader>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4"/>
}
else
{
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Class="tc-fade-in">

        <MudTabPanel Text="Modpacks" Icon="@Icons.Material.Filled.Inventory2" Class="pa-6">
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                Valores já preenchidos ao criar um modpack ou uma versão. Nada aqui altera
                o que já existe.
            </MudText>

            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_defaultMcVersion" Label="Versão do Minecraft padrão"
                                  Variant="Variant.Outlined" Placeholder="ex.: 1.21.1"
                                  HelperText="Deixe vazio para não sugerir nenhuma."/>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="ModLoader" @bind-Value="_defaultLoader" Label="Loader padrão"
                               Variant="Variant.Outlined">
                        @foreach (var loader in Enum.GetValues<ModLoader>())
                        {
                            <MudSelectItem T="ModLoader" Value="loader">@loader</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_defaultMemoryMb" Label="RAM padrão (MB)"
                                     Variant="Variant.Outlined" Min="512" Step="512"/>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_worldBackupKeepCount"
                                     Label="Backups automáticos a manter"
                                     HelperText="Por servidor. Zero = ilimitado. Backups manuais nunca expiram."
                                     Variant="Variant.Outlined" Min="0" Max="50"/>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Integrações" Icon="@Icons.Material.Filled.Extension" Class="pa-6">
            <MudText Typo="Typo.subtitle1" Class="mb-1">CurseForge</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                Sem a chave da API, o TCMine funciona só com o Modrinth. A chave é
                guardada cifrada e nunca é exibida de volta.
            </MudText>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                @if (_hasCurseForgeKey)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text"
                             Icon="@Icons.Material.Filled.CheckCircle">
                        Chave configurada
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text"
                             Icon="@Icons.Material.Filled.RemoveCircleOutline">
                        Sem chave
                    </MudChip>
                }
            </MudStack>

            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudTextField @bind-Value="_curseForgeKey" Label="Chave da API"
                                  InputType="InputType.Password" Variant="Variant.Outlined"
                                  Disabled="_clearCurseForgeKey"
                                  HelperText="@(_hasCurseForgeKey ? "Deixe vazio para manter a chave atual." : "Cole a chave gerada no console do CurseForge.")"/>
                </MudItem>
                @if (_hasCurseForgeKey)
                {
                    <MudItem xs="12" md="4" Class="d-flex align-center">
                        <MudCheckBox @bind-Value="_clearCurseForgeKey" Color="Color.Error"
                                     Label="Remover a chave"/>
                    </MudItem>
                }
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="E-mail" Icon="@Icons.Material.Filled.Email" Class="pa-6">
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                Usado na recuperação de senha. Enquanto não houver servidor configurado,
                as mensagens vão para o log do servidor em vez de serem enviadas.
            </MudText>

            @* Servidor próprio antes dos campos: quem for usá-lo não precisa
               preencher nada abaixo — subir já deixa tudo apontado. *@
            <MudPaper Class="pa-4 mb-5" Outlined="true" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3" Wrap="Wrap.Wrap">
                    <MudIcon Icon="@Icons.Material.Filled.Dns" Color="Color.Primary"/>
                    <MudText Typo="Typo.subtitle2">Servidor de e-mail próprio</MudText>

                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@EstadoCor">@EstadoTexto</MudChip>

                    <MudSpacer/>

                    @if (_mailBusy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
                    }

                    @if (_mail?.State is MailServerState.Running)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Stop"
                                   OnClick="PararServidorAsync" Disabled="_mailBusy">
                            Parar
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                   OnClick="SubirServidorAsync" Disabled="_mailBusy">
                            Subir servidor
                        </MudButton>
                    }
                </MudStack>

                <MudTextField @bind-Value="_mailDomain" Label="Domínio" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Placeholder="exemplo.com" Disabled="_mailBusy"
                              HelperText="O domínio de onde as mensagens vão sair. Você precisa controlar o DNS dele."/>

                @if (_mail?.DnsRecords.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Publique estes registros no DNS</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Sem eles a mensagem sai daqui e é classificada como spam do outro lado.
                        O DKIM só aparece depois do primeiro arranque, quando a chave é gerada.
                    </MudText>

                    <div style="overflow-x:auto;">
                        <MudTable Items="_mail.DnsRecords" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Tipo</MudTh>
                                <MudTh>Nome</MudTh>
                                <MudTh>Valor</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Tipo">@context.Type</MudTd>
                                <MudTd DataLabel="Nome">
                                    <MudText Typo="Typo.caption" Style="font-family:monospace;">
                                        @context.Name
                                    </MudText>
                                </MudTd>
                                <MudTd DataLabel="Valor">
                                    <MudText Typo="Typo.caption" Style="font-family:monospace; word-break:break-all;">
                                        @context.Value
                                    </MudText>
                                    <MudText Typo="Typo.caption" Style="opacity:.7;">@context.Why</MudText>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>

                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                        Falta uma coisa que não dá para fazer daqui: o DNS reverso (PTR) do IP
                        desta máquina precisa apontar para mail.@_mailDomain, e isso se configura
                        com quem fornece o IP. Sem ele, boa parte dos destinatários recusa.
                    </MudAlert>
                }
            </MudPaper>

            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudTextField @bind-Value="_smtpHost" Label="Servidor SMTP"
                                  Variant="Variant.Outlined" Placeholder="smtp.exemplo.com"/>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_smtpPort" Label="Porta"
                                     Variant="Variant.Outlined" Min="1" Max="65535"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_smtpUser" Label="Usuário"
                                  Variant="Variant.Outlined"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_smtpPassword" Label="Senha"
                                  InputType="InputType.Password" Variant="Variant.Outlined"
                                  Disabled="_clearSmtpPassword"
                                  HelperText="@(_hasSmtpPassword ? "Deixe vazio para manter a senha atual." : null)"/>
                </MudItem>
                <MudItem xs="12" md="8">
                    <MudTextField @bind-Value="_smtpFrom" Label="Remetente"
                                  Variant="Variant.Outlined"
                                  Placeholder="TCMine &lt;nao-responda@exemplo.com&gt;"/>
                </MudItem>
                <MudItem xs="12" md="4" Class="d-flex align-center">
                    <MudSwitch @bind-Value="_smtpUseTls" Color="Color.Primary" Label="Usar TLS"/>
                </MudItem>
                @if (_hasSmtpPassword)
                {
                    <MudItem xs="12">
                        <MudCheckBox @bind-Value="_clearSmtpPassword" Color="Color.Error"
                                     Label="Remover a senha salva"/>
                    </MudItem>
                }

                @* Teste depois de salvar, e não em vez de salvar: o envio usa a
                   configuração GRAVADA, então testar um formulário ainda não
                   salvo mediria a configuração antiga e enganaria. *@
                <MudItem xs="12">
                    <MudDivider Class="my-3"/>
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Testar o envio</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Salve as alterações antes de testar — o teste usa a configuração já gravada.
                    </MudText>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                        <MudTextField @bind-Value="_testEmailTo" Label="Enviar para"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Style="max-width:360px;" Disabled="_testing"/>

                        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Send"
                                   OnClick="SendTestAsync" Disabled="_testing">
                            Enviar teste
                        </MudButton>

                        @if (_testing)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
                        }
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

    </MudTabs>
}
