@page "/admin/settings"
@using TCMine.Contracts.Modpacks
@using TCMine.Server.Domain.Servers
@using TCMine.Server.Domain.Settings

<PageTitle>Configurações — TCMine</PageTitle>

<PageHeader Title="Configurações"
            Subtitle="Padrões e integrações desta instalação."
            Icon="@Icons.Material.Filled.Settings">
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Save"
               OnClick="Save" Disabled="_isSaving || _isLoading">
        @if (_isSaving)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
        }
        Salvar
    </MudButton>
</PageHeader>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4"/>
}
else
{
    @* Coluna central, não a largura inteira de .tc-page: um MudTextField
       esticado a 1440px fica tão largo que vira difícil de ler. *@
    <div class="tc-centered-column" style="max-width:900px;">
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="tc-fade-in">

            <MudTabPanel Text="Modpacks" Icon="@Icons.Material.Filled.Inventory2" Class="pa-6">
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                    Valores já preenchidos ao criar um modpack ou uma versão. Nada aqui altera
                    o que já existe.
                </MudText>

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_defaultMcVersion" Label="Versão do Minecraft padrão"
                                      Variant="Variant.Outlined" Placeholder="ex.: 1.21.1"
                                      HelperText="Deixe vazio para não sugerir nenhuma."/>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="ModLoader" @bind-Value="_defaultLoader" Label="Loader padrão"
                                   Variant="Variant.Outlined">
                            @foreach (var loader in Enum.GetValues<ModLoader>())
                            {
                                <MudSelectItem T="ModLoader" Value="loader">@loader</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="_defaultMemoryMb" Label="RAM padrão (MB)"
                                         Variant="Variant.Outlined" Min="512" Step="512"/>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="_worldBackupKeepCount"
                                         Label="Backups automáticos a manter"
                                         HelperText="Por servidor. Zero = ilimitado. Backups manuais nunca expiram."
                                         Variant="Variant.Outlined" Min="0" Max="50"/>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Rede" Icon="@Icons.Material.Filled.Router" Class="pa-6">
                <MudText Typo="Typo.subtitle1" Class="mb-1">Como os jogadores encontram esta máquina</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                    Escolha uma forma. Só os campos dela aparecem; o que você preencheu nas outras
                    fica guardado e volta se você voltar a ela.
                </MudText>

                @* Escolha única, e não três grupos de campos: antes os três conviviam
                   e quem vencia dependia do que estava preenchido, sem nada na tela
                   dizer qual. *@
                <MudGrid Spacing="2" Class="mb-4">
                    @foreach (var option in NetworkOptions)
                    {
                        var selected = _networkMode == option.Mode;
                        <MudItem xs="12" md="4" @key="option.Mode">
                            <MudPaper Outlined="true" Class="pa-4 d-flex flex-column gap-1"
                                      Style="@CardStyle(selected)" role="radio" aria-checked="@(selected ? "true" : "false")"
                                      tabindex="0" @onclick="@(() => _networkMode = option.Mode)">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@option.Icon" Color="@(selected ? Color.Primary : Color.Default)"/>
                                    <MudText Typo="Typo.subtitle2" Style="flex:1;">@option.Title</MudText>
                                    @if (selected)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Primary" Size="Size.Small"/>
                                    }
                                </MudStack>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@option.Description</MudText>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>

                @switch (_networkMode)
                {
                    case NetworkMode.Automatic:
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            @if (_isDetecting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">Detectando o IP público…</MudText>
                            }
                            else if (_detectedAddress is null)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                    Não foi possível detectar o IP público agora. A detecção tenta de novo sozinha.
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2">IP público detectado: <b>@_detectedAddress</b></MudText>
                                <MudTooltip Text="Copiar">
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                                   OnClick="CopyDetectedAddress"/>
                                </MudTooltip>
                            }
                        </MudStack>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                            Numa ligação de casa esse IP costuma mudar de vez em quando. Quando mudar, os
                            amigos precisam do endereço novo — um domínio evita isso.
                        </MudText>
                        break;

                    case NetworkMode.OwnHost:
                        <MudTextField @bind-Value="_publicHost" Label="Domínio ou DDNS"
                                      Variant="Variant.Outlined" Placeholder="ex.: jogar.meudominio.com"
                                      Immediate="true" Required="true"
                                      HelperText="Sem porta: cada servidor usa a dele. O nome tem de apontar para o IP desta casa — é o que um serviço de DDNS mantém. Também aceita um IP fixo."/>
                        @if (_detectedAddress is not null)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                                Para conferir: o IP desta casa agora é <b>@_detectedAddress</b>.
                            </MudText>
                        }
                        break;

                    case NetworkMode.Cloudflare:
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                            O TCMine mantém na sua zona um registro com o IP desta casa e, para cada servidor
                            com subdomínio, um nome próprio sem porta (sobrevivencia.seu-dominio.com). Só mexe
                            nos registros que ele mesmo criou. Funciona no Minecraft Java; o Bedrock não
                            consulta esses registros.
                        </MudText>

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                            @if (_hasCloudflareToken && !_clearCloudflareToken)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text"
                                         Icon="@Icons.Material.Filled.CheckCircle">token configurado</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text"
                                         Icon="@Icons.Material.Filled.ErrorOutline">falta o token</MudChip>
                            }
                        </MudStack>

                        <MudGrid>
                            <MudItem xs="12" md="8">
                                <MudTextField @bind-Value="_cloudflareToken" Label="Token da API"
                                              InputType="InputType.Password" Variant="Variant.Outlined"
                                              Disabled="_clearCloudflareToken" Immediate="true"
                                              HelperText="@(_hasCloudflareToken ? "Deixe vazio para manter o token atual." : "Crie um token só para isto, com a permissão Zone → DNS → Edit e restrito a esta zona.")"/>
                            </MudItem>
                            @if (_hasCloudflareToken)
                            {
                                <MudItem xs="12" md="4" Class="d-flex align-center">
                                    <MudCheckBox @bind-Value="_clearCloudflareToken" Color="Color.Error"
                                                 Label="Remover o token"/>
                                </MudItem>
                            }
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_cloudflareZoneId" Label="Zone ID"
                                              Variant="Variant.Outlined" Immediate="true"
                                              HelperText="32 caracteres, na página Overview do domínio na Cloudflare."/>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_dnsBaseDomain" Label="Domínio dos servidores"
                                              Variant="Variant.Outlined" Placeholder="ex.: seu-dominio.com"
                                              Immediate="true"
                                              HelperText="Os servidores ficam um nível abaixo dele. Tem de estar dentro da zona."/>
                            </MudItem>
                        </MudGrid>

                        @* O que um leigo não precisa ver para funcionar: fechado por padrão. *@
                        <MudExpansionPanels Elevation="0" Dense="true" Class="mt-3">
                            <MudExpansionPanel Text="Avançado" Expanded="_advancedInitiallyOpen">
                                <MudTextField @bind-Value="_dnsHostLabel" Label="Nome do registro do IP"
                                              Variant="Variant.Outlined" Placeholder="@GameDns.DefaultHostLabel"
                                              Immediate="true" Disabled="_cloudflareUsesPublicHost"
                                              HelperText="@($"O TCMine mantém {DnsHostPreview} apontado para o IP desta casa.")"/>

                                <MudCheckBox @bind-Value="_cloudflareUsesPublicHost" Class="mt-3"
                                             Label="Apontar para um DDNS ou IP fixo que eu já mantenho"/>
                                @if (_cloudflareUsesPublicHost)
                                {
                                    <MudTextField @bind-Value="_publicHost" Label="DDNS ou IP fixo"
                                                  Variant="Variant.Outlined" Placeholder="ex.: casa.ddns.net"
                                                  Immediate="true"
                                                  HelperText="Os registros dos servidores apontam para ele, e o TCMine deixa de manter o registro do IP."/>
                                }
                            </MudExpansionPanel>
                        </MudExpansionPanels>

                        <MudText Typo="Typo.subtitle2" Class="mt-6 mb-1">Atualização do DNS</MudText>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="6" Class="d-flex align-center">
                                <MudSwitch T="bool" Value="@(!_dnsManualSyncOnly)"
                                           ValueChanged="@(v => _dnsManualSyncOnly = !v)"
                                           Color="Color.Primary" Label="Atualizar sozinho"/>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSelect T="int" @bind-Value="_dnsSyncIntervalMinutes" Label="De quanto em quanto tempo"
                                           Variant="Variant.Outlined" Dense="true" Disabled="_dnsManualSyncOnly">
                                    @foreach (var minutes in InstallationSettings.DnsSyncIntervalChoices)
                                    {
                                        <MudSelectItem T="int" Value="minutes">
                                            @(minutes == 60 ? "A cada hora" : $"A cada {minutes} minutos")@(minutes == 5 ? " (recomendado)" : "")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                        @if (_dnsManualSyncOnly)
                        {
                            @* Desligar é legítimo (zona mexida à mão, teste), mas o
                               efeito colateral não é óbvio: servidor novo também
                               fica sem nome até o clique. *@
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                                Os registros só mudam quando você clicar em <b>Sincronizar agora</b> — também
                                depois de criar ou editar um servidor, e quando o IP desta casa mudar.
                            </MudAlert>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                                Também roda logo depois de salvar um servidor ou estas configurações. Quanto
                                maior o intervalo, mais tempo os amigos ficam sem entrar depois de o IP desta
                                casa mudar.
                            </MudText>
                        }

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-4">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Sync"
                                       OnClick="SyncDnsAsync" Disabled="_isSyncingDns || _isSaving">
                                @if (_isSyncingDns)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                                }
                                Sincronizar agora
                            </MudButton>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Usa o que está salvo.
                            </MudText>
                        </MudStack>

                        @if (_dnsOutcome is not null)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-4">
                                Última sincronização: @DnsOutcomeAge
                            </MudText>
                        }

                        @if (_dnsReport is { Enabled: false })
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                                Nada foi feito: a Cloudflare não está escolhida e completa nas configurações salvas.
                            </MudAlert>
                        }
                        else if (_dnsReport is not null)
                        {
                            <MudAlert Severity="@(_dnsReport.Succeeded ? Severity.Success : Severity.Warning)"
                                      Variant="Variant.Outlined" Dense="true" Class="mt-2">
                                @_dnsReport.Created criado(s), @_dnsReport.Updated atualizado(s),
                                @_dnsReport.Deleted apagado(s), @_dnsReport.Unchanged já certo(s).
                                @foreach (var problem in _dnsReport.Problems)
                                {
                                    <div>@problem</div>
                                }
                            </MudAlert>
                        }
                        break;
                }

                @* A prévia sai da MESMA regra que publica o endereço
                   (AddressSettings.From), com os campos ainda não salvos. Uma
                   prévia calculada à parte acabaria dizendo uma coisa e o
                   launcher recebendo outra. *@
                <MudPaper Outlined="true" Class="pa-4 mt-6" Style="border-color:var(--mud-palette-primary);">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" Size="Size.Small"/>
                        <MudText Typo="Typo.subtitle2">O que os jogadores recebem</MudText>
                    </MudStack>
                    @foreach (var line in PreviewLines)
                    {
                        <MudStack Row="true" Spacing="2" Class="py-1" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="min-width:220px;">@line.Label</MudText>
                            @if (line.Address is { Length: > 0 } address)
                            {
                                <MudText Typo="Typo.body2"><code>@address</code></MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Warning">@line.Missing</MudText>
                            }
                        </MudStack>
                    }
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                        Exemplo com a primeira porta da faixa. Vale depois de salvar.
                    </MudText>
                </MudPaper>

                <MudDivider Class="my-6"/>

                <MudText Typo="Typo.subtitle1" Class="mb-1">Rede de casa</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                    O IP desta máquina na sua rede de casa. Quem joga na mesma rede entra por ele, sem
                    passar pela internet: muitos roteadores não deixam alcançar o próprio IP público
                    por dentro, e aí o endereço acima, que funciona para os amigos de fora, falha
                    para quem está em casa. O launcher experimenta este primeiro e só o usa se
                    responder. Vale em qualquer uma das formas acima.
                </MudText>

                <MudTextField @bind-Value="_lanHost" Label="IP na rede local"
                              Variant="Variant.Outlined" Placeholder="ex.: 192.168.1.100" Immediate="true"
                              HelperText="Sem porta: cada servidor usa a dele. Está nas configurações de rede da máquina ou na lista de aparelhos do roteador. Vazio = desligado."/>

                <MudDivider Class="my-6"/>

                <MudText Typo="Typo.subtitle1" Class="mb-1">Portas dos servidores</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                    Cada servidor de jogo publica uma porta própria nesta máquina. Um servidor
                    novo recebe a primeira livre desta faixa; quem já existe mantém a sua, mesmo
                    que fique fora dela.
                </MudText>

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="_gamePortRangeStart" Label="Primeira porta"
                                         Variant="Variant.Outlined" Immediate="true"
                                         Min="GamePortRange.Min" Max="GamePortRange.Max"/>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="_gamePortRangeEnd" Label="Última porta"
                                         Variant="Variant.Outlined"
                                         Min="GamePortRange.Min" Max="GamePortRange.Max"/>
                    </MudItem>
                </MudGrid>

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-4">
                    Para jogadores de fora da sua rede entrarem, o roteador precisa redirecionar
                    estas portas (TCP) para esta máquina. Redirecionar a faixa inteira de uma vez
                    evita voltar ao roteador a cada servidor novo.
                </MudAlert>

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    Se nada de fora entra mesmo com tudo certo, a operadora pode estar usando CGNAT: o
                    IP é dividido entre vários clientes e o redirecionamento do roteador não funciona.
                    O sinal mais comum é o IP da WAN mostrado pelo roteador ser diferente do detectado.
                    A saída é pedir um IP público à operadora.
                </MudAlert>
            </MudTabPanel>

            <MudTabPanel Text="Integrações" Icon="@Icons.Material.Filled.Extension" Class="pa-6">
                <MudText Typo="Typo.subtitle1" Class="mb-1">CurseForge</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                    Sem a chave da API, o TCMine funciona só com o Modrinth. A chave é
                    guardada cifrada e nunca é exibida de volta.
                </MudText>

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                    @if (_hasCurseForgeKey)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text"
                                 Icon="@Icons.Material.Filled.CheckCircle">
                            chave configurada
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text"
                                 Icon="@Icons.Material.Filled.RemoveCircleOutline">
                            sem chave
                        </MudChip>
                    }
                </MudStack>

                <MudGrid>
                    <MudItem xs="12" md="8">
                        <MudTextField @bind-Value="_curseForgeKey" Label="Chave da API"
                                      InputType="InputType.Password" Variant="Variant.Outlined"
                                      Disabled="_clearCurseForgeKey"
                                      HelperText="@(_hasCurseForgeKey ? "Deixe vazio para manter a chave atual." : "Cole a chave gerada no console do CurseForge.")"/>
                    </MudItem>
                    @if (_hasCurseForgeKey)
                    {
                        <MudItem xs="12" md="4" Class="d-flex align-center">
                            <MudCheckBox @bind-Value="_clearCurseForgeKey" Color="Color.Error"
                                         Label="Remover a chave"/>
                        </MudItem>
                    }
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Login" Icon="@Icons.Material.Filled.Login" Class="pa-6">
                <MudText Typo="Typo.subtitle1" Class="mb-1">Login com a Microsoft</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                    O launcher prova a conta do jogador contra uma app registrada no Entra ID
                    (Azure) e troca essa prova por uma sessão aqui. Sem o client ID, o launcher
                    recusa o pareamento pedindo para avisar o administrador — ninguém entra.
                </MudText>

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                    @if (!string.IsNullOrWhiteSpace(_azureClientId))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text"
                                 Icon="@Icons.Material.Filled.CheckCircle">
                            login configurado
                        </MudChip>
                    }
                    else if (_hasAzureClientIdFromFile)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text"
                                 Icon="@Icons.Material.Filled.Description">
                            configurado por arquivo
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text"
                                 Icon="@Icons.Material.Filled.ErrorOutline">
                            jogadores não conseguem entrar
                        </MudChip>
                    }
                </MudStack>

                @* Sem este aviso, quem configurou por appsettings abre esta tela, vê o
               campo vazio e conclui que o login está quebrado — quando está de pé. *@
                @if (_hasAzureClientIdFromFile)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-4">
                        Há um client ID definido em <code>Server:AzureClientId</code> (appsettings ou
                        variável de ambiente): <strong>@_azureClientIdFromFile</strong>. Ele vale
                        enquanto o campo abaixo estiver vazio. Preencher aqui tem precedência e
                        passa a valer no próximo handshake, sem reiniciar o servidor.
                    </MudAlert>
                }

                <MudGrid>
                    <MudItem xs="12" md="8">
                        <MudTextField @bind-Value="_azureClientId" Label="ID do aplicativo (cliente)"
                                      Variant="Variant.Outlined" Immediate="true"
                                      Placeholder="00000000-0000-0000-0000-000000000000"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Custom.Brands.Microsoft"
                                      HelperText="GUID do registro no Entra ID. Não é segredo: o launcher o recebe no handshake."/>
                    </MudItem>
                </MudGrid>

                <MudText Typo="Typo.subtitle2" Class="mt-8 mb-2">Como registrar a app no Azure</MudText>

                <MudList T="string" Dense="true" Class="mb-4">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.LooksOne">
                        <MudText Typo="Typo.body2">
                            No <strong>portal.azure.com</strong>, abra <em>Microsoft Entra ID → Registros
                                de aplicativo → Novo registro</em>.
                        </MudText>
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.LooksTwo">
                        <MudText Typo="Typo.body2">
                            Em tipos de conta, escolha <strong>somente contas Microsoft pessoais</strong>.
                            Conta de Minecraft é sempre conta pessoal; escolher o tipo organizacional faz
                            todo login falhar, e o erro aparece só na máquina do jogador.
                        </MudText>
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Looks3">
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Adicione a plataforma <strong>cliente público / nativo</strong> e registre os
                            dois URIs do launcher abaixo — um por caminho de login, e faltando o do
                            broker o jogador precisa digitar a senha toda vez:
                        </MudText>
                        <MudPaper Outlined="true" Class="pa-3 mb-1">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Navegador do sistema</MudText>
                            <MudText Typo="Typo.body2"><code>http://localhost</code></MudText>
                        </MudPaper>
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Broker do Windows (WAM)</MudText>
                            <MudText Typo="Typo.body2">
                                <code>ms-appx-web://microsoft.aad.brokerplugin/@(_azureClientIdPreview)</code>
                            </MudText>
                        </MudPaper>
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Looks4">
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Adicione TAMBÉM a plataforma <strong>Web</strong> e registre este terceiro
                            URI — é por ele que o PAINEL (não o launcher) entra com a Microsoft:
                        </MudText>
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Login do painel</MudText>
                            <MudText Typo="Typo.body2"><code>@_microsoftCallbackUrl</code></MudText>
                        </MudPaper>
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Looks5">
                        <MudText Typo="Typo.body2">
                            Habilite <strong>permitir fluxos de cliente público</strong> e copie o
                            <em>ID do aplicativo (cliente)</em> para o campo acima. A app não precisa de
                            segredo: o fluxo usa PKCE, e um segredo no launcher seria público de qualquer forma.
                        </MudText>
                    </MudListItem>
                </MudList>

                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                    A Mojang exige aprovação para apps de terceiros usarem a API de autenticação do
                    Minecraft. Enquanto ela não sai, o registro fica correto e o login ainda falha na
                    etapa do XSTS — não adianta procurar erro na configuração daqui.
                </MudAlert>
            </MudTabPanel>

            @* Não é configuração e não passa pelo Salvar: é onde o admin confere
               a versão sem esperar o aviso do topo, que responde do cache. *@
            <MudTabPanel Text="Atualizações" Icon="@Icons.Material.Filled.SystemUpdateAlt" Class="pa-6">
                <ServerUpdatePanel/>
            </MudTabPanel>

        </MudTabs>
    </div>
}
