@* Cabeçalho padrão de diálogo: ícone num avatar + título (e subtítulo opcional).
   Dá a todos os diálogos a mesma cara — mais sólida que um texto solto. Vai
   dentro do <TitleContent> do MudDialog. *@

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
    <MudAvatar Color="Color.Primary" Variant="Variant.Outlined">
        <MudIcon Icon="@Icon"/>
    </MudAvatar>
    <div>
        <MudText Typo="Typo.h6">@Text</MudText>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Subtitle</MudText>
        }
    </div>
</MudStack>
