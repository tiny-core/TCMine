@using TCMine.Server.Web.Configuration

@if (_release is not null && !_dismissed)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mx-4 mt-2"
              ShowCloseIcon="true" CloseIconClicked="@(() => _dismissed = true)">
        <b>TCMine Server @_release.Version disponível</b> — esta instalação roda @BuildInfo.Version.
        Para atualizar, faça <code>docker compose pull &amp;&amp; docker compose up -d</code>.
        <MudLink Href="@_release.Page.ToString()" Target="_blank" Class="ml-1">O que mudou</MudLink>
    </MudAlert>
}
