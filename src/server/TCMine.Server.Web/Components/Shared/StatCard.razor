@* Card de métrica do painel: ícone tintado + valor grande + rótulo. *@

<MudItem xs="12" sm="6" md="3">
    <MudCard Class="tc-fade-in" Elevation="2">
        <MudCardContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudAvatar Color="IconColor" Variant="Variant.Outlined">
                    <MudIcon Icon="@Icon"/>
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h5">@Value</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Label</MudText>
                </div>
            </MudStack>
        </MudCardContent>
    </MudCard>
</MudItem>
