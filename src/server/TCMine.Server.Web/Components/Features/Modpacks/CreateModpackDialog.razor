@using TCMine.Contracts.Modpacks
@inherits DialogComponentBase

<MudDialog>
    <TitleContent>
        <DialogTitle Icon="@Icons.Material.Filled.Add" Text="Novo modpack"/>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField Value="_name"
                          ValueChanged="@((string v) => OnNameChanged(v))"
                          Label="Nome"
                          Required="true"
                          RequiredError="Informe um nome."
                          Immediate="true"
                          HelperText="Nome exibido aos jogadores."/>

            <MudTextField Value="_slug"
                          ValueChanged="@((string v) => OnSlugChanged(v))"
                          Label="Identificador"
                          ReadOnly="@(!_slugEditedManually)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Edit"
                          OnAdornmentClick="@(() => _slugEditedManually = true)"
                          HelperText="Gerado a partir do nome. Clique no lápis para editar."
                          Class="mt-3"/>

            <MudTextField @bind-Value="_summary"
                          Label="Descrição"
                          Lines="3"
                          HelperText="Opcional."
                          Class="mt-3"/>

            <MudAutocomplete T="string" @bind-Value="_minecraftVersion"
                             Label="Versão do Minecraft" SearchFunc="SearchMc"
                             CoerceValue="true" MaxItems="50" Required="true"
                             RequiredError="Escolha a versão do Minecraft." Class="mt-3"/>
            <MudSwitch T="bool" @bind-Value="_mcReleasesOnly" @bind-Value:after="ReloadMc"
                       Color="Color.Primary" Label="Só releases" Class="mt-1"/>

            <MudSelect T="ModLoader" @bind-Value="_loader" Label="Mod loader" Class="mt-3">
                @foreach (var l in Enum.GetValues<ModLoader>())
                {
                    <MudSelectItem T="ModLoader" Value="l">@l</MudSelectItem>
                }
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="IsBusy">
            @if (IsBusy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
            }
            Criar
        </MudButton>
    </DialogActions>
</MudDialog>
