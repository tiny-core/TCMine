@inherits DialogComponentBase

<MudDialog>
    <TitleContent>
        <DialogTitle Icon="@Icons.Material.Filled.Tune" Text="Versão do servidor"/>
    </TitleContent>
    <DialogContent>
        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
        }
        else
        {
            if (!Server.HasWorld)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                    Servidor sem mundo — a troca é imediata e segura.
                </MudText>
            }
            else if (!IsStopped)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3">
                    Este servidor tem mundo e está @Server.Status. Pare o servidor antes de trocar a versão:
                    o mundo precisa ser salvo, e trocar mods debaixo de quem está jogando quebra a sessão.
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                    Este servidor tem mundo. Antes da troca, o TCMine faz um backup automático do mundo
                    (pode levar alguns minutos num mundo grande); se o backup falhar, nada muda.
                    Mods removidos ou rebaixados podem estragar o save — o backup é o caminho de volta.
                </MudAlert>
            }

            <MudRadioGroup T="Guid" @bind-Value="_selectedVersionId">
                @foreach (var v in _versions)
                {
                    <MudRadio T="Guid" Value="v.Id" Class="d-block">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText>@v.Version</MudText>
                            <VersionStateChip State="v.State"/>
                            @if (v.Id == Server.ModpackVersionId)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                         Variant="Variant.Text">atual
                                </MudChip>
                            }
                        </MudStack>
                    </MudRadio>
                }
            </MudRadioGroup>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="IsBusy">Fechar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="Apply"
                   Disabled="IsBusy || !CanApply">
            @if (IsBusy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                <text>@(Server.HasWorld ? "Salvando o mundo…" : "Aplicando…")</text>
            }
            else
            {
                <text>@(Server.HasWorld ? "Fazer backup e trocar" : "Aplicar")</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>
