@inherits DialogComponentBase

<MudDialog>
    <TitleContent>
        <DialogTitle Icon="@Icons.Material.Filled.SystemUpdateAlt" Text="Verificar atualizações"/>
    </TitleContent>
    <DialogContent>
        @if (_isChecking)
        {
            @* Consulta uma origem por mod: num pack importado são centenas.
               O contador diz que está andando; a barra sozinha, não. *@
            @if (Progress is { IsDeterminate: true } p)
            {
                <MudProgressLinear Color="Color.Primary" Value="@p.Percent" Class="mt-3 mb-1"/>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @p.Done de @p.Total mods verificados
                </MudText>
            }
            else
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-3"/>
            }
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Comparando cada mod com a origem…</MudText>
        }
        else if (_updates.Count == 0)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Text">
                Tudo atualizado. Nenhum mod tem versão mais nova compatível.
            </MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                @_updates.Count mod(s) com atualização. Isto não altera a versão @SourceVersion —
                cria uma versão nova em rascunho com as trocas selecionadas.
            </MudText>

            <div style="max-height:45vh; overflow-y:auto;">
                @foreach (var u in _updates)
                {
                    <MudPaper Outlined="true" Elevation="0" Class="pa-2 mb-1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <MudCheckBox T="bool"
                                         Value="_selected.Contains(u.ProjectSlug)"
                                         ValueChanged="@(v => Toggle(u.ProjectSlug, v))"/>
                            <div>
                                <MudText Typo="Typo.body1">@u.ProjectSlug</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @u.CurrentFileName → @u.LatestFileName
                                </MudText>
                            </div>
                        </MudStack>
                    </MudPaper>
                }
            </div>

            <MudTextField @bind-Value="_newVersion"
                          Label="Número da nova versão"
                          Class="mt-3"
                          Disabled="IsBusy"/>
        }
    </DialogContent>
    <DialogActions>
        @if (_updates.Count == 0 && !_isChecking)
        {
            <MudButton OnClick="Cancel">Fechar</MudButton>
        }
        else if (_updates.Count > 0)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mr-auto ml-4">
                @_selected.Count selecionado(s)
            </MudText>
            <MudButton OnClick="Cancel" Disabled="IsBusy">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="Create"
                       Disabled="_selected.Count == 0 || string.IsNullOrWhiteSpace(_newVersion) || IsBusy">
                @if (IsBusy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                }
                Criar nova versão
            </MudButton>
        }
    </DialogActions>
</MudDialog>
