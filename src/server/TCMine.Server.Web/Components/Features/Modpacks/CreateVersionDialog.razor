@using TCMine.Server.Application.Abstractions
@using TCMine.Server.Application.Modpacks
@inject CreateModpackVersion CreateVersionUseCase
@inject ISnackbar Snackbar
@inject IVersionCatalog Catalog

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudText Typo="Typo.subtitle2" Class="mb-1">Versão do modpack</MudText>
            <VersionEditor @bind-Value="_version"/>
            
            <MudAutocomplete T="string" @bind-Value="_loaderVersion"
                             Label="Versão do loader" SearchFunc="SearchLoader"
                             CoerceValue="true" MaxItems="50" Required="true"
                             RequiredError="Informe a versão do loader." Class="mt-3"/>
            <MudSwitch T="bool" @bind-Value="_loaderReleasesOnly" @bind-Value:after="ReloadLoaderVersions"
                       Color="Color.Primary" Label="Só releases" Class="mt-1"/>

            <MudNumericField @bind-Value="_memoryMb"
                             Label="RAM recomendada (MB)"
                             HelperText="Opcional. Sugestão exibida ao jogador."
                             Min="512"
                             Class="mt-3"/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SubmitAsync"
                   Disabled="_isSaving">
            Criar
        </MudButton>
    </DialogActions>
</MudDialog>
