@inherits DialogComponentBase

<MudDialog>
    <TitleContent>
        <DialogTitle Icon="@Icons.Material.Filled.Add" Text="Nova versão"/>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudText Typo="Typo.subtitle2" Class="mb-1">Versão do modpack</MudText>
            <VersionEditor @bind-Value="_version"/>

            <LoaderVersionPicker @bind-Value="_loaderVersion"
                                 Loader="Loader" MinecraftVersion="MinecraftVersion"
                                 Class="mt-3"/>

            <MudNumericField @bind-Value="_memoryMb"
                             Label="RAM recomendada (MB)"
                             HelperText="Opcional. Sugestão exibida ao jogador."
                             Min="512"
                             Class="mt-3"/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudSwitch T="bool" @bind-Value="_inheritFiles" Color="Color.Primary"
                   Label="Herdar mods e overrides da última versão publicada" Class="mt-2"/>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Começa igual à anterior; remova na grade o que não for mais necessário.
        </MudText>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="IsBusy">
            Criar
        </MudButton>
    </DialogActions>
</MudDialog>
