@using TCMine.Contracts.Modpacks
@using TCMine.Server.Application.Abstractions
@using TCMine.Server.Application.Modpacks
@using TCMine.Server.Domain.Modpacks
@inject IModSearch Search
@inject IIngestionQueue Queue
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Buscar mods no Modrinth</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudTextField @bind-Value="_query"
                          Placeholder="Nome do mod…"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          OnKeyUp="OnKeyUp"
                          Disabled="_isSearching" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="DoSearch"
                       Disabled="_isSearching || string.IsNullOrWhiteSpace(_query)">
                Buscar
            </MudButton>
        </MudStack>

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
            Filtrando por Minecraft @MinecraftVersion · @Loader
        </MudText>

        @if (_isSearching)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-3" />
        }

        <div style="max-height:50vh; overflow-y:auto;" class="mt-2">
            @if (!_isSearching && _searched && _results.Count == 0)
            {
                <MudText Align="Align.Center" Color="Color.Secondary" Class="my-6">
                    Nenhum mod encontrado para "@_query".
                </MudText>
            }
            else if (!_searched)
            {
                <MudText Align="Align.Center" Color="Color.Secondary" Class="my-6">
                    Busque um mod pelo nome.
                </MudText>
            }

            @foreach (var r in _results)
            {
                <MudPaper Outlined="true" Elevation="0" Class="pa-2 mb-1"
                          @onclick="@(() => Toggle(r.ProjectId, !_selected.Contains(r.ProjectId)))"
                          Style="cursor:pointer;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudCheckBox T="bool"
                                     Value="_selected.Contains(r.ProjectId)"
                                     ValueChanged="@(v => Toggle(r.ProjectId, v))" />
                        <MudAvatar Rounded="true">
                            @if (!string.IsNullOrEmpty(r.IconUrl))
                            {
                                <MudImage Src="@r.IconUrl" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Extension" />
                            }
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.body1">@r.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@r.Description</MudText>
                        </div>
                    </MudStack>
                </MudPaper>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-auto ml-4">
            @_selected.Count selecionado(s)
        </MudText>
        <MudButton OnClick="Cancel" Disabled="_isAdding">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="Add"
                   Disabled="_selected.Count == 0 || _isAdding">
            @if (_isAdding)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Adicionar
        </MudButton>
    </DialogActions>
</MudDialog>
