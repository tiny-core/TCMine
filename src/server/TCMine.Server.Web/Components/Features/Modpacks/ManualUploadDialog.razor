@using TCMine.Contracts.Modpacks
@inherits DialogComponentBase

<MudDialog>
    <TitleContent>
        <DialogTitle Icon="@Icons.Material.Filled.Upload" Text="Enviar arquivo"/>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (PendingName is { Length: > 0 } pendente)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    Enviando o arquivo de <b>@pendente</b>. A pendência some assim que ele entrar.
                </MudAlert>
            }

            <MudSelect @bind-Value="_targetFolder" Label="Pasta de destino" Dense="true">
                <MudSelectItem Value="@("mods")">mods/</MudSelectItem>
                <MudSelectItem Value="@("config")">config/</MudSelectItem>
                <MudSelectItem Value="@("resourcepacks")">resourcepacks/</MudSelectItem>
                <MudSelectItem Value="@("shaderpacks")">shaderpacks/</MudSelectItem>
                <MudSelectItem Value="@("kubejs")">kubejs/</MudSelectItem>
            </MudSelect>

            <MudSelect @bind-Value="_side" Label="Lado" Dense="true">
                <MudSelectItem Value="FileSide.Both">Ambos</MudSelectItem>
                <MudSelectItem Value="FileSide.ClientOnly">Só cliente</MudSelectItem>
                <MudSelectItem Value="FileSide.ServerOnly">Só servidor</MudSelectItem>
            </MudSelect>

            <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected">
                <CustomContent Context="fileUpload">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AttachFile"
                               Disabled="IsBusy" FullWidth="true"
                               OnClick="@fileUpload.OpenFilePickerAsync">
                        @if (IsBusy)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                        }
                        Selecionar arquivo
                    </MudButton>
                </CustomContent>
            </MudFileUpload>

            @if (IsBusy && _total > 0)
            {
                @* Barra com bytes reais: "12,4 MB de 200 MB" é a diferença entre
                   esperar tranquilo e achar que travou. *@
                <div>
                    <MudProgressLinear Color="Color.Primary" Value="@SentPercent" Class="mb-1"/>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @HumanSize.Bytes(_sent) de @HumanSize.Bytes(_total)
                        @(_sent >= _total ? " — gravando e verificando o hash…" : "")
                    </MudText>
                </div>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Fechar</MudButton>
    </DialogActions>
</MudDialog>
