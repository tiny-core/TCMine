@using TCMine.Contracts.Modpacks
@* Escolha da versão do loader.
   Extraído porque criar e editar uma versão pedem exatamente a mesma coisa:
   a lista vem do catálogo, filtra por texto e alterna entre "só releases" e
   tudo. Duplicar isto nos dois diálogos deixaria os dois livres para divergir
   — e o de editar herdaria só metade do comportamento. *@

<MudAutocomplete T="string" Value="Value" ValueChanged="OnChanged"
                 Label="@Label" SearchFunc="Search"
                 CoerceValue="true" MaxItems="50" Required="@Required"
                 RequiredError="Informe a versão do loader." Class="@Class"/>

<MudSwitch T="bool" @bind-Value="_releasesOnly" @bind-Value:after="ReloadAsync"
           Color="Color.Primary" Label="Só releases" Class="mt-1"/>

@* Os dois estados que uma lista vazia escondia: "não consegui saber" e "não
   existe". Sem o aviso, o campo vazio parecia defeito do painel. *@
@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-1"/>
}
else if (_failed)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-2">
        Não foi possível carregar as versões do @Loader agora. Você pode digitar a
        versão; ela será conferida de novo ao publicar.
    </MudAlert>
}
else if (_versions.Count == 0 && Loader is not ModLoader.Vanilla && !string.IsNullOrWhiteSpace(MinecraftVersion))
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2">
        @(_releasesOnly
            ? $"Não há release do {Loader} para o Minecraft {MinecraftVersion}. Desligue \"Só releases\" para ver as betas."
            : $"Não há {Loader} para o Minecraft {MinecraftVersion}.")
    </MudAlert>
}
