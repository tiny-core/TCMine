@inherits DialogComponentBase

<MudDialog>
    <TitleContent>
        <DialogTitle Icon="@Icons.Material.Filled.Dns" Text="@(_isNew ? "Novo servidor" : "Editar servidor")"/>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Nome" Immediate="true" Class="mb-2"/>
        <MudTextField @bind-Value="_connectAddress" Label="Endereço de conexão"
                      HelperText="Host:porta que os jogadores usam, ex.: play.meuserver.com:25565"
                      Immediate="true" Class="mb-2"/>
        <MudGrid>
            <MudItem xs="6">
                <MudNumericField @bind-Value="_memoryMb" Label="Memória (MB)" Min="1024" Step="512"/>
            </MudItem>
            <MudItem xs="6">
                <MudNumericField @bind-Value="_maxPlayers" Label="Máx. jogadores" Min="1"/>

                @* O Minecraft não tem senha de entrada — a lista de servidores do
                   cliente guarda endereço e nome, mais nada. A whitelist é o que o
                   jogo oferece, e o TCMine a mantém a partir de quem tem convite. *@
                <MudSwitch T="bool" @bind-Value="_whitelistEnabled" Color="Color.Primary"
                           Label="Só quem tem convite entra"/>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Mantém a whitelist do servidor com os membros deste painel. Desligue para
                    deixá-lo aberto a qualquer conta.
                </MudText>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="IsBusy">Cancelar</MudButton>
        @if (_isNew)
        {
            <MudSelect T="Guid" @bind-Value="_selectedVersionId" Label="Versão do modpack" Class="mb-1">
                @foreach (var v in _versions)
                {
                    <MudSelectItem T="Guid" Value="v.Id">@v.Version</MudSelectItem>
                }
            </MudSelect>
            @if (_selected is not null)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3 d-block">
                    Minecraft @_selected.LoaderVersion · @SelectedModCount mod(s)
                </MudText>
            }
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="Save"
                   Disabled="IsBusy || string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_connectAddress) || (_isNew && _selectedVersionId == Guid.Empty)">
            @if (IsBusy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
            }
            Salvar
        </MudButton>

    </DialogActions>
</MudDialog>
