@using TCMine.Server.Domain.Servers
@inherits DialogComponentBase

<MudDialog>
    <TitleContent>
        <DialogTitle Icon="@Icons.Material.Filled.Dns" Text="@(_isNew ? "Novo servidor" : "Editar servidor")"/>
    </TitleContent>
    <DialogContent>
        @* Abas: a primeira é o servidor em si; as demais são as opções de jogo,
           uma por grupo do catálogo (GameOptions). Acrescentar uma opção ou um
           grupo é mexer no catálogo — esta tela não muda.
           KeepPanelsAlive: sem ele o MudTabs descarta a aba que não está à
           vista, e com ela o estado dos campos que ainda não foram salvos. *@
        <MudTabs Elevation="0" Rounded="true" KeepPanelsAlive="true">
            <MudTabPanel Text="Servidor" Icon="@Icons.Material.Filled.Dns" Class="pt-4">
                <MudTextField @bind-Value="_name" Label="Nome" Immediate="true" Class="mb-2"/>
                @* Value + ValueChanged em vez de @bind: trocar a porta precisa levar o
                   endereço junto, e isso só dá para fazer vendo o valor ANTIGO. *@
                @* Lista, e não caixa de texto: só aparecem portas que servem — dentro
                   da faixa que o admin redirecionou no roteador, e livres. Digitar um
                   número deixava escolher uma porta que subia sem erro e por onde
                   ninguém de fora entrava. *@
                <MudSelect T="int" Value="_gamePort" ValueChanged="OnGamePortChanged" Label="Porta"
                           HelperText="@PortHelp" Disabled="@(!PortOptions.Any())" Class="mb-2">
                    @foreach (var port in PortOptions)
                    {
                        <MudSelectItem T="int" Value="port">@PortLabel(port)</MudSelectItem>
                    }
                </MudSelect>

                @if (_portSuggestionError is not null)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-2">
                        @_portSuggestionError
                    </MudAlert>
                }

                @* Uma forma só: antes o endereço escrito e o subdomínio conviviam, e o
                   escrito vencia em silêncio. Os valores digitados nas outras opções
                   ficam enquanto o formulário está aberto; o Salvar grava só o da
                   escolhida. *@
                <MudText Typo="Typo.subtitle2" Class="mt-2">Como os jogadores chegam a este servidor</MudText>
                <MudRadioGroup T="ServerAddressKind" @bind-Value="_addressKind">
                    <MudRadio T="ServerAddressKind" Value="ServerAddressKind.Installation" Color="Color.Primary"
                              Dense="true" Class="d-block">
                        Pelo endereço desta instalação
                    </MudRadio>
                    <MudRadio T="ServerAddressKind" Value="ServerAddressKind.Subdomain" Color="Color.Primary"
                              Dense="true" Class="d-block"
                              Disabled="@(!CanUseSubdomain && _addressKind != ServerAddressKind.Subdomain)">
                        Por um nome próprio, sem porta
                    </MudRadio>
                    <MudRadio T="ServerAddressKind" Value="ServerAddressKind.Manual" Color="Color.Primary"
                              Dense="true" Class="d-block">
                        Por um endereço que eu escrevo
                    </MudRadio>
                </MudRadioGroup>

                @switch (_addressKind)
                {
                    case ServerAddressKind.Installation:
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                            O que está em Configurações → Rede, mais a porta deste servidor.
                            @if (!CanUseSubdomain)
                            {
                                <span>Um nome próprio sem porta precisa da Cloudflare configurada lá.</span>
                            }
                        </MudText>
                        break;

                    case ServerAddressKind.Subdomain:
                        <MudTextField @bind-Value="_subdomain" Label="Subdomínio"
                                      Placeholder="@GameDns.Suggest(_name)"
                                      HelperText="@SubdomainHelp"
                                      Immediate="true" Class="mb-2"/>
                        @if (!CanUseSubdomain)
                        {
                            @* Só um servidor que já tinha subdomínio chega aqui sem a
                               Cloudflare: o nome fica guardado, e não é publicado. *@
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-2">
                                A Cloudflare não está escolhida e completa em Configurações → Rede: o nome
                                fica guardado, mas os jogadores recebem o endereço da instalação.
                            </MudAlert>
                        }
                        break;

                    case ServerAddressKind.Manual:
                        <MudTextField @bind-Value="_connectAddress" Label="Endereço de conexão"
                                      Placeholder="ex.: jogo.outrodominio.com"
                                      HelperText="Outro domínio só deste servidor, ou uma porta que o roteador redireciona. Sem porta, entra a deste servidor."
                                      Immediate="true" Class="mb-2"/>
                        @if (ExplicitAddressPort is { } addressPort && addressPort != _gamePort)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-2">
                                O endereço aponta para a porta @addressPort e o servidor publica a @_gamePort. Só
                                funciona se o roteador redirecionar uma para a outra. Para o endereço seguir a
                                porta do servidor, apague o ":@(addressPort)" dele.
                            </MudAlert>
                        }
                        break;
                }

                @* O que os jogadores recebem de fato — o mesmo cálculo que vai ao launcher. *@
                @if (PublishedAddress.Length > 0)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                        Os jogadores entram por <b>@PublishedAddress</b>
                    </MudText>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-2">
                        @(_addressKind is ServerAddressKind.Manual
                            ? "Escreva o endereço acima."
                            : "Sem endereço para publicar: o IP público não foi detectado e não há domínio em Configurações → Rede.")
                    </MudAlert>
                }
                <MudGrid>
                    <MudItem xs="6">
                        <MudNumericField @bind-Value="_memoryMb" Label="Memória (MB)" Min="1024" Step="512"/>
                    </MudItem>
                    <MudItem xs="6">
                        <MudNumericField @bind-Value="_maxPlayers" Label="Máx. jogadores" Min="1"/>

                        @* O Minecraft não tem senha de entrada — a lista de servidores do
                           cliente guarda endereço e nome, mais nada. A whitelist é o que o
                           jogo oferece, e o TCMine a mantém a partir de quem tem convite. *@
                        <MudSwitch T="bool" @bind-Value="_whitelistEnabled" Color="Color.Primary"
                                   Label="Só quem tem convite entra"/>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Mantém a whitelist do servidor com os membros deste painel. Desligue para
                            deixá-lo aberto a qualquer conta.
                        </MudText>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            @foreach (var group in GameOptions.Catalog.GroupBy(o => o.Group))
            {
                <MudTabPanel Text="@group.Key" BadgeData="@DefinedIn(group)" BadgeColor="Color.Primary" Class="pt-4">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
                        Tudo aqui é opcional. O que você não definir fica como o modpack traz. As
                        mudanças valem a partir do próximo início do servidor.
                    </MudText>

                    @foreach (var option in group)
                    {
                        @switch (option.Kind)
                        {
                            case GameOptionKind.Toggle:
                                @* Lista de três estados, e não checkbox: um
                                   checkbox desmarcado não distingue "desligado"
                                   de "não mexer", e são coisas diferentes. *@
                                <MudSelect T="string" Value="@GetOption(option.Key)"
                                           ValueChanged="@(v => SetOption(option.Key, v))"
                                           Label="@option.Label" HelperText="@option.Description" Class="mb-3">
                                    <MudSelectItem T="string" Value="@("")">Padrão do modpack</MudSelectItem>
                                    <MudSelectItem T="string" Value="@GameOptions.On">Ligado</MudSelectItem>
                                    <MudSelectItem T="string" Value="@GameOptions.Off">Desligado</MudSelectItem>
                                </MudSelect>
                                break;

                            case GameOptionKind.Choice:
                                <MudSelect T="string" Value="@GetOption(option.Key)"
                                           ValueChanged="@(v => SetOption(option.Key, v))"
                                           Label="@option.Label" HelperText="@option.Description" Class="mb-3">
                                    <MudSelectItem T="string" Value="@("")">Padrão do modpack</MudSelectItem>
                                    @foreach (var choice in option.Choices)
                                    {
                                        <MudSelectItem T="string" Value="@choice.Value">@choice.Label</MudSelectItem>
                                    }
                                </MudSelect>
                                break;

                            case GameOptionKind.Number:
                                <MudNumericField T="int?" Value="@GetNumber(option.Key)"
                                                 ValueChanged="@(v => SetNumber(option.Key, v))"
                                                 Label="@option.Label" HelperText="@option.Description"
                                                 Min="@option.Min" Max="@option.Max" Clearable="true"
                                                 Placeholder="padrão do modpack" Class="mb-3"/>
                                break;

                            default:
                                <MudTextField T="string" Value="@GetOption(option.Key)"
                                              ValueChanged="@(v => SetOption(option.Key, v))"
                                              Label="@option.Label" HelperText="@option.Description"
                                              MaxLength="@option.MaxLength" Clearable="true"
                                              Placeholder="padrão do modpack" Class="mb-3"/>
                                break;
                        }
                    }
                </MudTabPanel>
            }
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="IsBusy">Cancelar</MudButton>
        @if (_isNew)
        {
            <MudSelect T="Guid" @bind-Value="_selectedVersionId" Label="Versão do modpack" Class="mb-1">
                @foreach (var v in _versions)
                {
                    <MudSelectItem T="Guid" Value="v.Id">@v.Version</MudSelectItem>
                }
            </MudSelect>
            @if (_selected is not null)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3 d-block">
                    Minecraft @_minecraftVersion · @_selected.LoaderVersion · @SelectedModCount mod(s)
                </MudText>
            }
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="Save"
                   Disabled="IsBusy || string.IsNullOrWhiteSpace(_name) || (_isNew && _selectedVersionId == Guid.Empty)">
            @if (IsBusy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
            }
            Salvar
        </MudButton>

    </DialogActions>
</MudDialog>
