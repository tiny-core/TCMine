@inherits DialogComponentBase

<MudDialog>
    <TitleContent>
        <DialogTitle Icon="@Icons.Material.Filled.SystemUpdateAlt" Text="Atualizar a partir da origem"/>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudText Typo="Typo.body2" Class="mb-2">
                @(Progress?.Step is { Length: > 0 } passo ? passo : "Comparando com a origem…")
            </MudText>
            <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
        }
        else if (_error is { Length: > 0 })
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">@_error</MudAlert>
        }
        else if (_plan is { } plan)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                <b>@CurrentLabel</b> → <b>@_latestLabel</b>. Isto cria uma <b>versão nova em rascunho</b>;
                a atual não é tocada.
            </MudText>

            @* A regra inteira numa frase: quem não entende de merge precisa
               saber só o que a caixa marcada faz. *@
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mb-3">
                <b>Marcado</b> = entra a mudança do autor. <b>Desmarcado</b> = fica como está aqui.
                Conflitos (você e o autor mexeram na mesma coisa) vêm desmarcados.
            </MudAlert>

            <MudStack Row="true" Spacing="2" Class="mb-3" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                         Icon="@Icons.Material.Filled.Checklist">@_accepted.Count de @TotalItems marcados
                </MudChip>
                @if (plan.TotalConflicts > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                             Icon="@Icons.Material.Filled.CallSplit">@plan.TotalConflicts conflitos
                    </MudChip>
                }
                @if (plan.Kept.Count > 0)
                {
                    <MudTooltip Text="Mods que você acrescentou e o autor não tem: ficam sempre, sem pergunta.">
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                                 Icon="@Icons.Material.Filled.Lock">@plan.Kept.Count mods seus, mantidos
                        </MudChip>
                    </MudTooltip>
                }
            </MudStack>

            <MudExpansionPanels Elevation="0" Dense="true" MultiExpansion="true">
                @foreach (var section in _sections)
                {
                    <MudExpansionPanel @key="section.Title" Expanded="@section.IsConflicts"
                                       Text="@($"{section.Title} — {Marked(section)} de {section.Items.Count} marcados")">
                        <MudStack Row="true" Spacing="1" Class="mb-1">
                            <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="IsBusy"
                                       OnClick="@(() => SetAll(section, true))">Marcar todos
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="IsBusy"
                                       OnClick="@(() => SetAll(section, false))">Desmarcar todos
                            </MudButton>
                        </MudStack>

                        @* Virtualize: um pack grande muda centenas de configs de
                           uma vez, e centenas de caixas de uma vez travam o
                           circuito. A altura máxima é o que dá a ele a área de
                           rolagem de que precisa. *@
                        <div style="max-height:340px; overflow-y:auto;">
                            <Virtualize Items="section.Items" Context="item" ItemSize="44">
                                <div @key="item.Key" class="d-flex align-start gap-1 py-1">
                                    <MudCheckBox T="bool" Value="@_accepted.Contains(item.Key)"
                                                 ValueChanged="@(v => Toggle(item.Key, v))"
                                                 Disabled="IsBusy" Dense="true" Size="Size.Small"/>
                                    <MudIcon Icon="@item.Icon" Size="Size.Small" Class="mt-2"/>
                                    <div style="min-width:0; flex:1;" class="mt-1">
                                        <MudText Typo="Typo.body2" Class="text-truncate">@item.Title</MudText>
                                        @if (item.Detail is { Length: > 0 })
                                        {
                                            <MudText Typo="Typo.caption" Style="opacity:.8;">@item.Detail</MudText>
                                        }
                                        @if (item.CanCompare)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                                       StartIcon="@Icons.Material.Filled.Compare"
                                                       OnClick="@(() => ToggleCompareAsync(item.Path!))">
                                                @(_comparing == item.Path ? "Fechar" : "Ver os dois lados")
                                            </MudButton>
                                        }
                                    </div>
                                </div>
                                @if (_comparing is { } aberto && aberto == item.Path)
                                {
                                    <MudGrid Spacing="2" Class="mb-2">
                                        <MudItem xs="12" md="6">
                                            <MudText Typo="Typo.caption"><b>O seu (fica se desmarcado)</b></MudText>
                                            <pre style="@PreStyle">@(_ourText ?? "Carregando…")</pre>
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <MudText Typo="Typo.caption"><b>O do autor (entra se marcado)</b></MudText>
                                            <pre style="@PreStyle">@_theirText</pre>
                                        </MudItem>
                                    </MudGrid>
                                }
                            </Virtualize>
                        </div>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>

            <MudTextField @bind-Value="_newVersion" Label="Número da nova versão"
                          HelperText="A nossa numeração, independente da do autor."
                          Class="mt-4" Disabled="IsBusy"/>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="IsBusy">Cancelar</MudButton>
        @if (_plan is { IsEmpty: false })
        {
            <MudTooltip Text="@(_accepted.Count == 0 ? "Marque ao menos uma mudança." : null)"
                        Disabled="@(_accepted.Count > 0)">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.SystemUpdateAlt"
                           OnClick="Apply"
                           Disabled="@(IsBusy || _accepted.Count == 0 || string.IsNullOrWhiteSpace(_newVersion))">
                    Criar rascunho
                </MudButton>
            </MudTooltip>
        }
        @if (IsBusy)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="flex:1; min-width:0;">
                <MudProgressCircular Size="Size.Small" Indeterminate="true"/>
                <MudText Typo="Typo.caption" Class="text-truncate">
                    @(Progress is { IsDeterminate: true } p
                        ? $"{p.Step} — {p.Done} de {p.Total}"
                        : Progress?.Step ?? "Trabalhando…")
                </MudText>
            </MudStack>
        }
    </DialogActions>
</MudDialog>
