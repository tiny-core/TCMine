@* Mods que a ingestão não trouxe. Não é erro a corrigir: no CurseForge é comum
   o autor bloquear a redistribuição, e a única saída legítima é o admin baixar
   da página do mod e subir o .jar aqui.

   Expansível e fechado por padrão: um pack grande traz uma dúzia deles, e a
   lista aberta empurrava as estatísticas da versão para fora da tela toda vez
   que se abria o modpack. O título já diz quantos são — quem quiser agir abre. *@

<MudExpansionPanels Class="mb-4" Elevation="0">
    <MudExpansionPanel Expanded="false">
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.CloudOff" Color="Color.Warning"/>
                <MudText Typo="Typo.subtitle1" Style="font-weight:600;">
                    @Pending.Count mod(s) aguardando upload manual
                </MudText>
            </MudStack>
        </TitleContent>
        <ChildContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.body2" Style="flex:1; min-width:240px; opacity:.8;">
                    A versão continua utilizável — estes mods simplesmente não vieram. Baixe o
                    arquivo na página do mod e envie aqui; a pendência some sozinha quando o
                    arquivo entrar.
                </MudText>
                @if (CanRetry)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="OnRetry" Disabled="IsBusy">
                        Tentar de novo
                    </MudButton>
                }
            </MudStack>

            <MudTable Items="Pending" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Mod</MudTh>
                    <MudTh>Motivo</MudTh>
                    <MudTh Style="text-align:right;">Ações</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Mod">
                        <MudText Typo="Typo.body2" Style="font-weight:600;">@context.DisplayName</MudText>
                        @if (context.Detail is { Length: > 0 })
                        {
                            <MudText Typo="Typo.caption" Style="opacity:.8;">@context.Detail</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Motivo">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Color="@ColorFor(context.Reason)">
                            @LabelFor(context.Reason)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Ações" Style="text-align:right;">
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd" Wrap="Wrap.Wrap">
                            @if (context.PageUrl is { Length: > 0 } url)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                           StartIcon="@Icons.Material.Filled.OpenInNew"
                                           Href="@url" Target="_blank">
                                    Abrir na origem
                                </MudButton>
                            }

                            @if (CanUpload)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Upload"
                                           OnClick="@(() => OnUpload.InvokeAsync(context))">
                                    Enviar .jar
                                </MudButton>
                            }
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>
