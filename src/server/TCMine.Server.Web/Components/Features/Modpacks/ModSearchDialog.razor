@using TCMine.Server.Domain.Modpacks
@inherits DialogComponentBase

<MudDialog>
    <TitleContent>
        <DialogTitle Icon="@Icons.Material.Filled.CloudDownload" Text="Buscar mods"/>
    </TitleContent>
    <DialogContent>
        @* Origem: só aparece quando há mais de uma disponível. O CurseForge
           entra na lista assim que a chave de API é configurada. *@
        @if (_available.Count > 1)
        {
            <MudToggleGroup T="ModFileOrigin" Value="_origin" ValueChanged="OnOriginChanged"
                            Color="Color.Primary" Size="Size.Small" CheckMark="true"
                            SelectionMode="SelectionMode.SingleSelection" Class="mb-3">
                @foreach (var origin in _available)
                {
                    <MudToggleItem T="ModFileOrigin" Value="origin" Text="@origin.ToString()"/>
                }
            </MudToggleGroup>
        }

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            @* Busca conforme digita, com folga de 400ms: exigir clique num
               botão para ver qualquer resultado torna a procura um vaivém. *@
            <MudTextField T="string" Value="_query" ValueChanged="OnQueryChanged"
                          Placeholder="Nome do mod…"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          DebounceInterval="400"
                          Clearable="true"/>
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-1" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                @_origin · Minecraft @MinecraftVersion · @Loader
            </MudText>
            <MudSpacer/>
            @if (_incompatibleCount > 0)
            {
                <MudSwitch T="bool" Value="_hideIncompatible" ValueChanged="OnHideChanged"
                           Color="Color.Primary" Size="Size.Small"
                           Label="@($"Ocultar {_incompatibleCount} incompatíveis")"/>
            }
        </MudStack>

        @if (_available.Count == 1 && _origin is ModFileOrigin.Modrinth)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                Configure a chave da API em Configurações para buscar também no CurseForge.
            </MudText>
        }

        @if (_isSearching)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-3"/>
        }

        <div style="max-height:50vh; overflow-y:auto;" class="mt-2">
            @if (!_isSearching && _searched && _results.Count == 0)
            {
                <MudText Align="Align.Center" Class="mud-text-secondary my-6">
                    Nenhum mod encontrado para "@_query" no @_origin.
                    @if (_available.Count > 1)
                    {
                        <text>Tente a outra origem.</text>
                    }
                </MudText>
            }
            else if (!_isSearching && _searched && Visiveis.Count == 0)
            {
                @* Achou, mas todos foram escondidos pelo filtro. Dizer isso é a
                   diferença entre "não existe" e "não saiu para a sua versão". *@
                <MudText Align="Align.Center" Class="mud-text-secondary my-6">
                    Os @_results.Count resultados não têm versão para Minecraft @MinecraftVersion
                    com @Loader. Desligue "ocultar incompatíveis" para vê-los.
                </MudText>
            }
            else if (!_searched)
            {
                <MudText Align="Align.Center" Class="mud-text-secondary my-6">
                    Busque um mod pelo nome.
                </MudText>
            }

            @foreach (var r in Visiveis)
            {
                <MudPaper Outlined="true" Elevation="0" Class="pa-2 mb-1"
                          @onclick="@(() => Toggle(r.ProjectId, !_selected.Contains(r.ProjectId)))"
                          Style="@(r.Compatible ? "cursor:pointer;" : "cursor:not-allowed; opacity:.6;")">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudCheckBox T="bool"
                                     Value="_selected.Contains(r.ProjectId)"
                                     ValueChanged="@(v => Toggle(r.ProjectId, v))"
                                     Disabled="@(!r.Compatible)"/>
                        <MudAvatar Rounded="true">
                            @if (!string.IsNullOrEmpty(r.IconUrl))
                            {
                                <MudImage Src="@r.IconUrl"/>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Extension"/>
                            }
                        </MudAvatar>
                        <div style="flex:1; min-width:0;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                                <MudText Typo="Typo.body1">@r.Title</MudText>

                                @if (r.Downloads > 0)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @Downloads(r.Downloads) downloads
                                    </MudText>
                                }

                                @if (!r.Compatible)
                                {
                                    <MudTooltip Text="@IncompatibleHint(r)">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                                 Variant="Variant.Outlined">
                                            sem versão para @MinecraftVersion
                                        </MudChip>
                                    </MudTooltip>
                                }
                            </MudStack>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@r.Description</MudText>
                        </div>
                    </MudStack>
                </MudPaper>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mr-auto ml-4">
            @_selected.Count selecionado(s)
        </MudText>
        <MudButton OnClick="Cancel" Disabled="IsBusy">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="Add"
                   Disabled="_selected.Count == 0 || IsBusy">
            @if (IsBusy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
            }
            Adicionar
        </MudButton>
    </DialogActions>
</MudDialog>
