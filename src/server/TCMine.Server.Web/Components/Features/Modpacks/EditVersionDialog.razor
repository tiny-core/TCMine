@inherits DialogComponentBase

<MudDialog>
    <TitleContent>
        <DialogTitle Icon="@Icons.Material.Filled.Edit" Text="Editar versão"/>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Class="mb-1">Número da versão</MudText>
        <VersionEditor @bind-Value="_version"/>
        <MudNumericField @bind-Value="_memoryMb" Label="RAM recomendada (MB)"
                         Min="1024" Step="512" Class="mt-3"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="IsBusy">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save"
                   Disabled="IsBusy || string.IsNullOrWhiteSpace(_version)">
            @if (IsBusy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
            }
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>
