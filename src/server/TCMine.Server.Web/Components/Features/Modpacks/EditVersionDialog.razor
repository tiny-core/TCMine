@inherits DialogComponentBase

<MudDialog>
    <TitleContent>
        <DialogTitle Icon="@Icons.Material.Filled.Edit" Text="Editar versão"/>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Class="mb-1">Número da versão</MudText>
        <VersionEditor @bind-Value="_version"/>

        @* Editável no rascunho: a versão do loader pertence à versão, não ao
           modpack, e é comum errá-la ao criar. O que NÃO se edita aqui é a
           versão do Minecraft nem o loader — esses ficam no modpack e são
           imutáveis, porque mod não migra entre eles. *@
        <LoaderVersionPicker @bind-Value="_loaderVersion"
                             Loader="Loader" MinecraftVersion="MinecraftVersion"
                             Class="mt-3"/>

        <MudNumericField @bind-Value="_memoryMb" Label="RAM recomendada (MB)"
                         Min="1024" Step="512" Class="mt-3"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="IsBusy">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save"
                   Disabled="IsBusy || string.IsNullOrWhiteSpace(_version)
                             || string.IsNullOrWhiteSpace(_loaderVersion)">
            @if (IsBusy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
            }
            Salvar
        </MudButton>
    </DialogActions>
</MudDialog>
