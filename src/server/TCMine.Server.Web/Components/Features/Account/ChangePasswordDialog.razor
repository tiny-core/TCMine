@inherits DialogComponentBase

<MudDialog>
    <TitleContent>
        <DialogTitle Icon="@Icons.Material.Filled.Password" Text="Alterar senha"/>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_current" Label="Senha atual"
                          InputType="InputType.Password" Variant="Variant.Outlined"
                          Required="true" RequiredError="Informe a senha atual."/>

            <MudTextField @bind-Value="_new" Label="Nova senha"
                          InputType="InputType.Password" Variant="Variant.Outlined"
                          Required="true" RequiredError="Informe a nova senha."
                          Validation="@(new Func<string, string?>(ValidateNew))" Immediate="true"/>

            <MudTextField @bind-Value="_confirm" Label="Confirmar nova senha"
                          InputType="InputType.Password" Variant="Variant.Outlined"
                          Required="true" RequiredError="Confirme a nova senha."
                          Validation="@(new Func<string, string?>(ValidateConfirm))" Immediate="true"/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="IsBusy">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="IsBusy">
            @if (IsBusy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
            }
            Alterar senha
        </MudButton>
    </DialogActions>
</MudDialog>
