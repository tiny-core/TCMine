@if (_servers is null)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px"/>
}
else if (_servers.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        Você ainda não tem servidores. Crie um em Servidores e volte aqui para ligá-lo à nuvem.
    </MudAlert>
}
else
{
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
        A chave de cada servidor é gerada pelo TCMine e renovada a cada início do servidor; ninguém precisa
        copiá-la. Ligar ou desligar a nuvem vale a partir do próximo início.
    </MudText>
    @if (_isBusy)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2"/>
    }

    <MudTable Items="_servers" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Servidor</MudTh>
            <MudTh>Nuvem</MudTh>
            <MudTh>Chave</MudTh>
            <MudTh Style="text-align:right;">Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Servidor">@context.Name</MudTd>
            <MudTd DataLabel="Nuvem">
                @if (context.AttachedHere)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">ligado
                    </MudChip>
                }
                else if (context.AttachedElsewhere)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">em outra
                        nuvem
                    </MudChip>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Desligado</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Chave">
                @if (context.Key is { } key)
                {
                    <MudText Typo="Typo.caption" Style="font-family:monospace;">tcs_@(key.Prefix)_…</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @(key.LastSeenAt is { } seen
                            ? $"último contato {seen.ToLocalTime():dd/MM HH:mm} · mod {key.ModVersion ?? "?"}"
                            : "nunca usada")
                    </MudText>
                }
                else if (context.AttachedHere)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning">Sem chave: inicie (ou reinicie) o servidor
                    </MudText>
                }
            </MudTd>
            <MudTd Style="text-align:right;">
                @if (context.AttachedHere)
                {
                    @if (context.Key is not null)
                    {
                        <MudTooltip Text="Revogar chave">
                            <MudIconButton Icon="@Icons.Material.Filled.KeyOff" Size="Size.Small" Color="Color.Warning"
                                           OnClick="@(() => RevokeAsync(context))" Disabled="_isBusy"/>
                        </MudTooltip>
                    }

                    <MudTooltip Text="Desligar da nuvem">
                        <MudIconButton Icon="@Icons.Material.Filled.CloudOff" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DetachAsync(context))" Disabled="_isBusy"/>
                    </MudTooltip>
                }
                else
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.CloudQueue"
                               OnClick="@(() => AttachAsync(context))" Disabled="_isBusy">
                        Ligar aqui
                    </MudButton>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}
