@using TCMine.Contracts.Servers
@* Console do container ao vivo.

   Só existe enquanto o servidor está no ar: seguir o log de um container parado
   devolveria o histórico e ficaria pendurado sem nunca receber nada. *@

<MudPaper Outlined="true" Class="tc-panel pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.Terminal" Color="Color.Primary"/>
        <MudText Typo="Typo.subtitle2">Console</MudText>

        @if (_streaming)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">ao vivo</MudChip>
        }

        <MudSpacer/>

        <MudText Typo="Typo.caption" Class="mud-text-secondary">@_lines.Count linhas</MudText>

        <MudTooltip Text="Rolar sozinho quando chegam linhas novas">
            <MudSwitch T="bool" @bind-Value="_autoScroll" Color="Color.Primary" Size="Size.Small"
                       Label="Seguir"/>
        </MudTooltip>

        <MudTooltip Text="Limpar a tela (não apaga nada no servidor)">
            <MudIconButton Icon="@Icons.Material.Filled.ClearAll" Size="Size.Small" OnClick="Clear"/>
        </MudTooltip>
    </MudStack>

    @if (Server.Status is not GameServerStatus.Running)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            O console aparece quando o servidor está no ar.
        </MudText>
    }
    else
    {
        @* Lado a lado com a referência quando ela está aberta — painel
           lateral, não um empurrando o outro para baixo. Fechada, o console
           ocupa a largura inteira sozinho (ver tc-console-layout). *@
        <div class="@(_showReference ? "tc-console-layout" : "")">
            <div class="tc-console-main">
                <div class="tc-console" id="@_consoleId">
                    @foreach (var entry in _lines)
                    {
                        <div class="tc-console-line @EntryClass(entry.Kind)">@entry.Text</div>
                    }

                    @if (_lines.Count == 0)
                    {
                        <div class="tc-console-line" style="opacity:.6;">Aguardando saída do servidor…</div>
                    }
                </div>

                @* Só para quem pode mandar comando: o servidor recusaria de
                   qualquer forma, mas uma caixa que só responde "não
                   permitido" é um convite a tentar. *@
                @if (CanSend)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2" Class="mt-3">
                        <MudTextField T="string" @ref="_inputField"
                                      Value="_input" ValueChanged="OnInputChanged" Immediate="true"
                                      OnKeyDown="OnInputKeyDown"
                                      Placeholder="Digite um comando — ex.: say Olá a todos"
                                      HelperText="@InputHelper"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Adornment="Adornment.Start" AdornmentText="›"
                                      Disabled="_sending" Class="tc-console-input"
                                      Style="font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace;"/>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Send"
                                   Disabled="@(_sending || string.IsNullOrWhiteSpace(_input))"
                                   OnClick="SendAsync" Class="mt-1">
                            @if (_sending)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                            }
                            Enviar
                        </MudButton>

                        <MudTooltip Text="Lista de comandos do Minecraft, com a sintaxe de cada um">
                            <MudButton Variant="@(_showReference ? Variant.Filled : Variant.Outlined)"
                                       StartIcon="@Icons.Material.Filled.MenuBook"
                                       OnClick="@(() => _showReference = !_showReference)" Class="mt-1">
                                Comandos
                            </MudButton>
                        </MudTooltip>
                    </MudStack>
                }
            </div>

            @if (CanSend && _showReference)
            {
                <div class="tc-console-side">
                    <MudTextField T="string" @bind-Value="_filter" Immediate="true"
                                  Placeholder="Filtrar por nome ou descrição"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" FullWidth="true"/>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                        Clique num comando para colocá-lo na caixa. Mods podem acrescentar outros — o console aceita
                        todos.
                    </MudText>

                    @foreach (var group in ReferenceGroups)
                    {
                        <MudText Typo="Typo.overline"
                                 Class="mud-text-secondary d-block mt-2">@CategoryLabel(group.Key)</MudText>

                        @foreach (var cmd in group)
                        {
                            <div class="tc-command-row" @onclick="@(() => UseCommandAsync(cmd))"
                                 @onkeydown="@(e => e.Key is "Enter" or " " ? UseCommandAsync(cmd) : Task.CompletedTask)"
                                 role="button" tabindex="0" title="Usar este comando">
                                <code class="tc-command-syntax">@cmd.Syntax</code>
                                <span class="tc-command-desc">@cmd.Description</span>
                                @if (cmd.Destructive)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                                        cuidado
                                    </MudChip>
                                }
                            </div>
                        }
                    }

                    @if (!ReferenceGroups.Any())
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Nenhum comando com esse nome.</MudText>
                    }
                </div>
            }
        </div>
    }
</MudPaper>
