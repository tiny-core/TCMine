@using TCMine.Server.Web.Configuration
@using TCMine.Server.Web.Endpoints
@* Menu de navegação lateral. Extraído do MainLayout para isolar a estrutura de
   navegação — novas seções entram aqui sem tocar no layout. O MudNavLink já
   destaca o item ativo pela rota. *@

<MudNavMenu>
    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary px-4 pt-3 pb-1">
        Geral
    </MudText>

    <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
        Painel
    </MudNavLink>

    <MudNavLink Href="/admin/servers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dns">
        Servidores
    </MudNavLink>

    <MudNavLink Href="/admin/mods" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Extension">
        Mods
    </MudNavLink>

    <MudNavLink Href="/admin/modpacks" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory2">
        Modpacks
    </MudNavLink>

    <MudNavLink Href="/admin/access-requests" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PersonAddAlt">
        Pedidos de acesso
    </MudNavLink>

    <MudNavLink Href="/admin/cloud" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Cloud">
        Nuvem de itens
    </MudNavLink>

    @* Gerenciar quem é admin é poder sobre a instalação inteira — só quem já
       é admin precisa enxergar o link. Esconder não substitui a checagem no
       caso de uso (ListUsers/SetInstanceAdmin já recusam sozinhos); é só para
       não oferecer no menu o que vai dar erro. *@
    <AuthorizeView>
        <Authorized>
            @if (context.User.HasClaim(c => c.Type == TcMineClaims.InstanceAdmin))
            {
                <MudNavLink Href="/admin/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Group">
                    Usuários
                </MudNavLink>
            }
        </Authorized>
    </AuthorizeView>

    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary px-4 pt-4 pb-1">
        Sistema
    </MudText>

    <MudNavLink Href="/admin/storage" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Storage">
        Armazenamento
    </MudNavLink>

    <MudNavLink Href="/admin/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">
        Configurações
    </MudNavLink>

    @* A versão em que esta instalação está rodando. Fica no menu, e não numa
       tela de "sobre", porque a pergunta aparece quando algo está errado — e aí
       ninguém quer procurar. Já houve uma imagem publicada com o container
       ainda na versão anterior, sem nada no painel que denunciasse. *@
    <MudText Typo="Typo.caption" Class="mud-text-secondary px-4 pt-4 pb-2 d-block">
        TCMine Server @BuildInfo.Version
    </MudText>
</MudNavMenu>
