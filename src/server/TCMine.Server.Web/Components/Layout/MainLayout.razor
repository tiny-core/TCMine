@inherits LayoutComponentBase

<MudThemeProvider Theme="TcMineTheme.Default"
                  @bind-IsDarkMode="_isDarkMode"
                  ObserveSystemDarkModeChange="false"/>
<MudPopoverProvider/>
@* Defaults consistentes para todos os diálogos: botão de fechar, fechar com ESC
   ou clique no fundo, largura padrão. Diálogos que passam DialogOptions próprios
   sobrescrevem estes. *@
<MudDialogProvider CloseButton="true"
                   CloseOnEscapeKey="true"
                   BackdropClick="true"
                   MaxWidth="MaxWidth.Small"
                   FullWidth="true"
                   Position="DialogPosition.Center"/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)"/>
        <MudIcon Icon="@Icons.Material.Filled.Dns" Class="ml-2 mr-2" Color="Color.Primary"/>
        <MudText Typo="Typo.h6">TCMine</MudText>
        <MudSpacer/>
        <MudTooltip Text="@(_isDarkMode ? "Tema claro" : "Tema escuro")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="ToggleDarkMode"/>
        </MudTooltip>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Responsive"
               ClipMode="DrawerClipMode.Always">
        <NavMenu/>
    </MudDrawer>

    <MudMainContent Class="pt-16 pa-4">
        @* Expõe o tema atual para páginas que renderizam fora do MudThemeProvider
           (ex.: o editor Monaco, que precisa casar vs-dark/vs com o app). *@
        <CascadingValue Value="_isDarkMode" Name="IsDarkMode">
            @Body
        </CascadingValue>
    </MudMainContent>
</MudLayout>
