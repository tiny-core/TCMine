@inherits LayoutComponentBase

<MudThemeProvider Theme="TcMineTheme.Default"
                  @bind-IsDarkMode="_isDarkMode"
                  ObserveSystemDarkModeChange="false"/>
<MudPopoverProvider/>
@* Defaults consistentes para todos os diálogos: botão de fechar, fechar com ESC
   ou clique no fundo, largura padrão. Diálogos que passam DialogOptions próprios
   sobrescrevem estes. *@
<MudDialogProvider CloseButton="true"
                   CloseOnEscapeKey="true"
                   BackdropClick="true"
                   MaxWidth="MaxWidth.Small"
                   FullWidth="true"
                   Position="DialogPosition.Center"/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)"/>
        <MudIcon Icon="@Icons.Material.Filled.Dns" Class="ml-2 mr-2" Color="Color.Primary"/>
        <MudText Typo="Typo.h6">TCMine</MudText>
        <MudSpacer/>
        <MudTooltip Text="@(_isDarkMode ? "Tema claro" : "Tema escuro")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="ToggleDarkMode"/>
        </MudTooltip>

        <AuthorizeView>
            <Authorized>
                <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                         title="Conta">
                    <MudText Typo="Typo.body2" Class="px-4 py-2">
                        @context.User.Identity?.Name
                    </MudText>
                    <MudDivider/>
                    <MudMenuItem Icon="@Icons.Material.Filled.Password" OnClick="OpenChangePassword">
                        Alterar senha
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="LogoutAsync">
                        Sair
                    </MudMenuItem>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Responsive"
               ClipMode="DrawerClipMode.Always">
        <NavMenu/>
    </MudDrawer>

    @* Sair precisa ser POST (apagar o cookie exige HttpContext vivo, e um
       logout por GET seria acionável por terceiros). O item de menu submete
       este form escondido. *@
    <form id="tc-logout-form" method="post" action="/auth/logout" hidden>
        <AntiforgeryToken/>
    </form>

    <MudMainContent Class="pt-16 pa-4">
        @* Expõe o tema atual para páginas que renderizam fora do MudThemeProvider
           (ex.: o editor Monaco, que precisa casar vs-dark/vs com o app). *@
        <CascadingValue Value="_isDarkMode" Name="IsDarkMode">
            @Body
        </CascadingValue>
    </MudMainContent>
</MudLayout>
