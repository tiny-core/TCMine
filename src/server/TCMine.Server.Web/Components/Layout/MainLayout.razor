@using TCMine.Server.Web.Endpoints
@inherits LayoutComponentBase

@* Só tema escuro: é o que o TCMine Design System define (pedra vulcânica,
   luz de minério). Não há alternador — um modo claro seria outro produto
   visual para manter, e a arte de caverna não existe nele. *@
<MudThemeProvider Theme="TcMineTheme.Default" IsDarkMode="true" ObserveSystemDarkModeChange="false"/>
<MudPopoverProvider/>
@* Defaults consistentes para todos os diálogos: botão de fechar, fechar com ESC
   ou clique no fundo, largura padrão. Diálogos que passam DialogOptions próprios
   sobrescrevem estes. *@
<MudDialogProvider CloseButton="true"
                   CloseOnEscapeKey="true"
                   BackdropClick="true"
                   MaxWidth="MaxWidth.Small"
                   FullWidth="true"
                   Position="DialogPosition.Center"/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="0" Class="tc-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)"/>
        <span class="tc-brand-mark ml-2 mr-3"><MudIcon Icon="@Icons.Material.Filled.ViewInAr" Size="Size.Small"/></span>
        <MudText Typo="Typo.h6" Style="font-weight:700;">TCMine</MudText>
        <MudSpacer/>
        <MudButton Href="/" Target="_blank" Variant="Variant.Text" Color="Color.Inherit"
                   StartIcon="@Icons.Material.Filled.Public" Class="mr-2">
            Página pública
        </MudButton>

        <AuthorizeView>
            <Authorized>
                <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                         title="Conta">
                    <MudText Typo="Typo.body2" Class="px-4 py-2">
                        @context.User.Identity?.Name
                    </MudText>
                    <MudDivider/>
                    @if (!context.User.HasClaim(c => c.Type == TcMineClaims.HasMinecraft))
                    {
                        @* Href direto, sem OnClick: isto só inicia o redirect para a
                           Microsoft, não muda nada por si — GET é o verbo certo. *@
                        <MudMenuItem Icon="@Icons.Custom.Brands.Microsoft"
                                     Href="/auth/microsoft/start?link=true&returnUrl=/admin">
                            Vincular conta Minecraft
                        </MudMenuItem>
                    }
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="LogoutAsync">
                        Sair
                    </MudMenuItem>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive"
               ClipMode="DrawerClipMode.Always">
        <NavMenu/>
    </MudDrawer>

    @* Sair precisa ser POST (apagar o cookie exige HttpContext vivo, e um
       logout por GET seria acionável por terceiros). O item de menu submete
       este form escondido. *@
    <form id="tc-logout-form" method="post" action="/auth/logout" hidden>
        <AntiforgeryToken/>
    </form>

    <MudMainContent Class="pt-16">
        @* Acompanhamento global: qualquer trabalho em background aparece aqui,
           em qualquer página. É o que dispensa prender o admin numa tela. *@
        <ActiveJobsBar/>
        @* Versão nova do servidor publicada: só o admin da instalação vê. *@
        <ServerUpdateBanner/>
        @* Expõe o tema para páginas que renderizam fora do MudThemeProvider
           (ex.: o editor Monaco, que precisa casar vs-dark com o app). *@
        <div class="pa-6 tc-page">
            <CascadingValue Value="true" Name="IsDarkMode">
                @Body
            </CascadingValue>
        </div>
    </MudMainContent>
</MudLayout>
