@inherits LayoutComponentBase

<MudThemeProvider Theme="TcMineTheme.Default"
                  @bind-IsDarkMode="_isDarkMode"
                  ObserveSystemDarkModeChange="false"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)"/>
        <MudText Typo="Typo.h6">TCMine</MudText>
        <MudSpacer/>
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="@(() => _isDarkMode = !_isDarkMode)"/>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Responsive">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                Painel
            </MudNavLink>
            <MudNavLink Href="/modpacks" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory2">
                Modpacks
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="pt-16 pa-4">
        @* Expõe o tema atual para páginas que renderizam fora do MudThemeProvider
           (ex.: o editor Monaco, que precisa casar vs-dark/vs com o app). *@
        <CascadingValue Value="_isDarkMode" Name="IsDarkMode">
            @Body
        </CascadingValue>
    </MudMainContent>
</MudLayout>
