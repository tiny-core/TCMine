<Project Sdk="Microsoft.NET.Sdk">

  <!--
      O que só existe no Windows.

      Este projeto é a válvula de escape prometida pelos comentários do
      Launcher.Core e do Launcher.Infrastructure: P/Invoke, DPAPI e, mais
      adiante, o MSAL com broker vivem aqui e em nenhum outro lugar. É o que faz
      um port para Linux ser um projeto novo do lado deste, em vez de uma
      reescrita.
  -->
  <PropertyGroup>
    <!--
        TFM seco, e fica assim. O broker do MSAL parecia exigir a versão do SDK
        (como o WebView2 no host exige, ver §8) — não exige: com os dois TFMs o
        NuGet resolve exatamente os mesmos assets, incluindo o NativeInterop que
        traz o runtime do WAM. Medido, não deduzido.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>

    <!-- [LibraryImport] gera marshalling unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    <PackageReference Include="Microsoft.Identity.Client"/>
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal"/>
    <PackageReference Include="Microsoft.Identity.Client.Broker"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TCMine.Launcher.Core\TCMine.Launcher.Core.csproj"/>
  </ItemGroup>

</Project>
