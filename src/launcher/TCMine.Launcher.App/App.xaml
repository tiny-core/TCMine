<Application x:Class="TCMine.Launcher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose"
             DispatcherUnhandledException="OnDispatcherUnhandledException">
    <!-- Sem StartupUri: a janela é criada pelo contêiner em App.xaml.cs, para
         nascer já com as dependências resolvidas.
         OnMainWindowClose: o console é outra janela, e com o padrão
         (OnLastWindowClose) ele aberto seguraria a aplicação depois de o
         jogador fechar a principal. -->
    <Application.Resources />
</Application>
