<Window x:Class="TCMine.Launcher.App.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:ui="clr-namespace:TCMine.Launcher.UI;assembly=TCMine.Launcher.UI"
        Title="Console do jogo — TCMine"
        Icon="icon.ico"
        Width="900" Height="560"
        MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B14">

    <!--
        Moldura normal do Windows, ao contrário da principal: aqui redimensionar
        e maximizar são o que se quer (um log lê-se melhor grande), e a barra de
        título do sistema já faz tudo isso sem uma linha nossa.

        Sem Owner de propósito: uma janela com dono minimiza junto com ele, e a
        principal minimiza quando o jogo abre — justamente a hora em que o
        console é útil.

        O mesmo index.html da principal, com outra raiz: os mesmos CSS, os
        mesmos scripts, e nada que precise de manter em dois lugares.
    -->
    <blazor:BlazorWebView x:Name="WebView" HostPage="wwwroot\index.html" Services="{DynamicResource services}">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type ui:ConsoleRoot}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>

</Window>
