<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
      A janela. Este é o ÚNICO projeto do launcher que não é portável, e é de
      propósito: tudo que fala com o Windows — WPF, WebView2, P/Invoke da moldura
      — está contido aqui. As telas vivem em TCMine.Launcher.UI e não sabem que
      existe uma janela.

      SDK.Razor e não SDK puro: é o que traz os alvos de static web assets, sem
      os quais o BlazorWebView não acha nem o CSS do MudBlazor nem os
      _content/ das bibliotecas referenciadas.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
        A versão do SDK do Windows no TFM não é decoração: o controle WPF do
        WebView2 renderiza por composição e, para isso, chama as projeções WinRT
        (Microsoft.Windows.SDK.NET). Com um "net10.0-windows" seco elas não são
        referenciadas, o build passa e a janela morre no primeiro quadro com um
        FileNotFoundException — que foi exatamente o que aconteceu aqui.
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>

    <!-- [LibraryImport] gera marshalling unsafe. Fica contido neste projeto. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Ícone do executável — Explorer, barra de tarefas, Alt+Tab. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
        O ApplicationIcon acima só EMBUTE o ícone no .exe; não copia o arquivo
        para a pasta de publish. O vpk precisa do arquivo físico ao lado do
        executável para gerar o Setup.exe com o mesmo ícone (ver
        VelopackLauncherBundle, flag "icon") — por isso entra também como Content.
    -->
    <Content Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf"/>
    <PackageReference Include="Microsoft.Extensions.Hosting"/>
    <PackageReference Include="Velopack"/>
    <PackageReference Include="Serilog.Extensions.Hosting"/>
    <PackageReference Include="Serilog.Sinks.File"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TCMine.Launcher.Infrastructure\TCMine.Launcher.Infrastructure.csproj"/>
    <ProjectReference Include="..\TCMine.Launcher.Infrastructure.Windows\TCMine.Launcher.Infrastructure.Windows.csproj"/>
    <ProjectReference Include="..\TCMine.Launcher.UI\TCMine.Launcher.UI.csproj"/>
  </ItemGroup>

</Project>
