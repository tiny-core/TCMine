@inherits LayoutComponentBase

@* Moldura da aplicação: barra de título, trilho de navegação, conteúdo e barra
   de estado. É o equivalente ao MainLayout do painel — mesmos provedores do
   MudBlazor, mesmos defaults de diálogo — com a diferença de que aqui a janela
   inteira é nossa, então o layout começa na barra de título e não no AppBar. *@

<MudThemeProvider Theme="TcMineTheme.Default" IsDarkMode="true" ObserveSystemDarkModeChange="false"/>
<MudPopoverProvider/>
<MudDialogProvider CloseButton="true"
                   CloseOnEscapeKey="true"
                   BackdropClick="true"
                   MaxWidth="MaxWidth.Small"
                   FullWidth="true"
                   Position="DialogPosition.Center"/>
<MudSnackbarProvider/>

@* Emite as variáveis --tc-* a partir de TcColors. No painel isto vai no <head>
   do App.razor; aqui não existe App.razor, então entra no topo da árvore — um
   <style> no corpo vale igual, e mantém o index.html sem lógica. *@
<TcMineTokens/>

<div class="tc-shell">
    <TitleBar/>

    <div class="tc-shell-body">
        @* O trilho só aparece com sessão: sem servidor não há catálogo, e sem
           jogador não há instância nem convite. Oferecer a navegação antes seria
           oferecer telas que não têm o que mostrar. *@
        @if (Shell.IsSignedIn)
        {
            <NavRail/>
        }

        <main class="tc-shell-content">
            @if (Shell.IsStartingUp)
            {
                @* Espera o pareamento resolver antes de renderizar qualquer
                   página. Sem isto a tela "Nada para jogar" pisca por um
                   instante antes de o redirecionamento acontecer. *@
                <div class="tc-shell-boot">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
                </div>
            }
            else
            {
                @if (Shell.ConnectionNotice is { } aviso)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined"
                              Dense="true" Class="mb-4">
                        @aviso
                    </MudAlert>
                }

                @Body
            }
        </main>
    </div>

    <StatusBar/>
</div>
