@* Barra de título do launcher.

   A moldura do Windows está desligada (WindowStyle=None no host), então esta
   faixa é a janela: título à esquerda, comandos à direita. Arrastar e os botões
   passam por IWindowChrome — ver a porta para o porquê. *@

<header class="tc-titlebar" @onmousedown="OnPointerDown">
    <img class="tc-titlebar-mark" src="_content/TCMine.Launcher.UI/brand-mark.png" alt="" aria-hidden="true"/>
    <span class="tc-titlebar-title">@Title</span>

    @* stopPropagation para o clique num botão não virar arrasto da janela: o
       mouse-down subiria até o header e o Windows tomaria conta do ponteiro
       antes do clique completar. *@
    <div class="tc-titlebar-actions" @onmousedown:stopPropagation="true">
        <MudTooltip Text="Minimizar" Placement="Placement.Bottom">
            <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                           Color="Color.Inherit" OnClick="Chrome.Minimize"
                           aria-label="Minimizar"/>
        </MudTooltip>
        @* Sem botão de maximizar: a janela não redimensiona (MainWindow.xaml,
           ResizeMode=CanMinimize) — só minimizar e fechar. *@
        <MudTooltip Text="Fechar" Placement="Placement.Bottom">
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                           Class="tc-titlebar-close" OnClick="Chrome.Close"
                           aria-label="Fechar"/>
        </MudTooltip>
    </div>
</header>
