@page "/instances"

<PageTitle>Instâncias</PageTitle>

<PageHeader Title="Instâncias" Subtitle="As instalações que ocupam disco nesta máquina.">
    @* Só aparece quando há o que libertar, e com o número no rótulo: "remover
       Java não utilizado" sem um tamanho ao lado é um botão que ninguém clica —
       e um botão permanente que às vezes não faz nada é pior. *@
    @if (_reclaimable > 0)
    {
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.CleaningServices"
                   Disabled="@(_busy || Lock.IsLocked)"
                   OnClick="CleanupJavaAsync">
            Libertar @HumanSize.Bytes(_reclaimable) de Java
        </MudButton>
    }

    <MudButton Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.Refresh"
               Disabled="_loading"
               OnClick="LoadAsync">
        Atualizar
    </MudButton>
</PageHeader>

@if (Operation.IsRunning)
{
    @* O andamento aqui e não num diálogo: atualizar demora, e um diálogo modal
       a girar prenderia a tela inteira por algo que o jogador pode acompanhar
       enquanto olha o resto. Operation é compartilhado: aparece aqui mesmo que
       a instalação tenha começado no catálogo e o jogador tenha navegado para
       cá no meio dela — antes esse progresso só existia na tela onde nasceu. *@
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.body2" Class="mb-2">@Operation.Progress?.Label</MudText>
        <MudProgressLinear Color="Color.Primary" Indeterminate="true"/>
    </MudPaper>
}

@if (_loading)
{
    <LoadingCards Count="3"/>
}
else if (_instances.Count is 0)
{
    <EmptyState Icon="@Icons.Material.Filled.Layers"
                Title="Nenhuma instância instalada"
                Description="Cada versão instalada vira uma pasta própria, com os mods ligados ao content store compartilhado — o mesmo mod em dois modpacks ocupa disco uma vez só.">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/modpacks">
            Ver modpacks
        </MudButton>
    </EmptyState>
}
else
{
    <MudStack Spacing="3">
        @foreach (var instancia in _instances)
        {
            <MudPaper Class="pa-4 tc-fade-in" Elevation="0" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                    <MudAvatar Color="Color.Primary" Rounded="true">
                        @instancia.Manifest.ModpackName[..1].ToUpperInvariant()
                    </MudAvatar>

                    <MudStack Spacing="0" Style="min-width:0;flex:1;">
                        <MudText Typo="Typo.subtitle1">@instancia.Manifest.ModpackName</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            v@(instancia.Manifest.Version)
                            · @HumanSize.Bytes(instancia.SizeBytes)
                            · @instancia.Manifest.ManagedFiles.Count arquivos
                        </MudText>
                    </MudStack>

                    @if (_updates.TryGetValue(instancia.Key, out var novidade))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Upgrade"
                                   Disabled="@(_busy || Lock.IsLocked)"
                                   OnClick="@(() => UpdateAsync(instancia, novidade))">
                            Atualizar para v@(novidade.Version)
                        </MudButton>
                    }

                    @if (_active == instancia.Key)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text"
                                 Icon="@Icons.Material.Filled.SportsEsports">
                            Ativa
                        </MudChip>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.SportsEsports"
                                   Disabled="@(_busy || Lock.IsLocked)"
                                   OnClick="@(() => ActivateAsync(instancia))">
                            Jogar esta
                        </MudButton>
                    }

                    @* Inline e estreito, em vez de um diálogo: é um número, e
                       abrir uma janela para o pedir custaria mais cliques do que
                       o ajuste vale. Grava ao sair do campo — a cada tecla
                       escreveria o manifesto meia dúzia de vezes. *@
                    <MudNumericField T="int?"
                                     Value="@instancia.Manifest.MemoryMb"
                                     ValueChanged="@(v => SetMemoryAsync(instancia, v))"
                                     Immediate="false"
                                     Min="@SetInstanceMemory.MinimumMb"
                                     Step="512"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Adornment="Adornment.End"
                                     AdornmentText="MB"
                                     Placeholder="padrão"
                                     Style="width:9rem;"
                                     Disabled="@(_busy || Lock.IsLocked)"/>

                    <MudTooltip Text="Abrir a pasta da instância">
                        <MudIconButton Icon="@Icons.Material.Filled.FolderOpen"
                                       OnClick="@(() => OpenFolder(instancia))"/>
                    </MudTooltip>

                    <MudTooltip Text="Remover a instância e o mundo dela">
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Color="Color.Error"
                                       Disabled="@(_busy || Lock.IsLocked)"
                                       OnClick="@(() => RemoveAsync(instancia))"/>
                    </MudTooltip>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
}
