@page "/"

<PageTitle>Jogar</PageTitle>

<PageHeader Title="Jogar"
            Subtitle="A instância ativa e o botão que abre o jogo."/>

@* O aviso de ligação vive na moldura, não aqui: repetir "sem ligação" em cada
   página faria o texto contradizer a barra de estado no dia em que uma delas
   ficasse para trás. *@
@if (_loading)
{
    <LoadingCards Count="1"/>
}
else if (_active is null)
{
    <EmptyState Icon="@Icons.Material.Filled.SportsEsports"
                Title="@(_needsChoice ? "Escolha o que jogar" : "Nada para jogar ainda")"
                Description="@(_needsChoice
                                 ? "Você tem mais de uma instância instalada. Marque uma como ativa para ela aparecer aqui."
                                 : "Instale um modpack para ele aparecer aqui, com o botão de jogar e o servidor a que ele pertence.")">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Href="@(_needsChoice ? "/instances" : "/modpacks")">
            @(_needsChoice ? "Ver instâncias" : "Ver modpacks")
        </MudButton>
    </EmptyState>
}
else
{
    <MudPaper Class="pa-6 tc-fade-in" Elevation="0" Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
            <MudAvatar Color="Color.Primary" Rounded="true" Size="Size.Large">
                @_active.Manifest.ModpackName[..1].ToUpperInvariant()
            </MudAvatar>

            <MudStack Spacing="1" Style="min-width:0;flex:1;">
                <MudText Typo="Typo.h6">@_active.Manifest.ModpackName</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    v@(_active.Manifest.Version) · @HumanSize.Bytes(_active.SizeBytes)
                </MudText>
            </MudStack>

            @* Desabilitado enquanto abre, e não só ocupado: clicar duas vezes
               abriria duas cópias do jogo na mesma pasta, e duas instâncias a
               escrever o mesmo mundo corrompem-no. *@
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.PlayArrow"
                       Disabled="@(_launching || !CanPlay)"
                       OnClick="PlayAsync">
                @if (_launching)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                }
                Jogar
            </MudButton>
        </MudStack>

        @if (_launching || _phase is not null)
        {
            <MudDivider Class="my-4"/>

            @* A fase em texto, e a barra só quando há fração: uma barra a fingir
               progresso num passo que não sabe medir ensina o jogador a
               desconfiar da barra toda. *@
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@_phase</MudText>

            @if (_fraction is { } fracao)
            {
                <MudProgressLinear Color="Color.Primary" Value="@(fracao * 100)" Class="mt-2"/>
            }
            else if (_launching)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2"/>
            }
        }

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-4">
                @_error
            </MudAlert>
        }

        @* Os servidores vêm do catálogo, não do manifesto: o administrador
           re-aponta um servidor para outra versão a qualquer momento, e um
           endereço gravado na instalação ficaria desatualizado calado. Sem rede,
           o card acima continua inteiro — só esta parte não aparece. *@
        @if (_servers.Count > 0)
        {
            <MudDivider Class="my-4"/>

            <MudText Typo="Typo.overline" Class="mud-text-secondary">Onde jogar</MudText>

            <MudStack Spacing="2" Class="mt-2">
                @foreach (var servidor in _servers)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <ServerStatusChip Status="servidor.Status"/>
                        <MudText Typo="Typo.body2">@servidor.Name</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            @servidor.ConnectAddress
                        </MudText>
                    </MudStack>
                }
            </MudStack>
        }
    </MudPaper>
}
