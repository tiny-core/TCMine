@page "/settings"

<PageTitle>Definições</PageTitle>

<PageHeader Title="Definições"
            Subtitle="Conta, servidor e opções do jogo. A memória é de cada instância."/>

@* Só o que já é verdade nesta build. Uma tela de definições cheia de campos
   desligados ensina o jogador a desconfiar do que ela mostra. *@
<MudStack Spacing="4" Class="tc-centered-column" Style="max-width:560px;">

    @if (Shell.Player is { } jogador)
    {
        <MudPaper Class="pa-6" Elevation="0" Outlined="true">
            <MudText Typo="Typo.subtitle1" GutterBottom="true">Conta</MudText>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                <MudAvatar Color="Color.Primary" Size="Size.Large">@Shell.AvatarInitial</MudAvatar>

                <MudStack Spacing="0">
                    <MudText Typo="Typo.body1">@jogador.DisplayName</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Conta Minecraft · @Shell.ServerName
                    </MudText>
                </MudStack>

                <MudSpacer/>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Logout"
                           Disabled="@(_signingOut || Lock.IsLocked)"
                           OnClick="SignOutAsync">
                    Sair
                </MudButton>
            </MudStack>

            @if (_signingOut)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-4"/>
            }
        </MudPaper>
    }

    <MudPaper Class="pa-6" Elevation="0" Outlined="true">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">Opções do jogo</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            As teclas de cada modpack ficam guardadas na sua conta: voltam em qualquer PC e em
            qualquer instância do mesmo modpack, de servidor ou sua.
        </MudText>

        @* Desligado por padrão: gráficos e som são do computador (um notebook
           e um PC de mesa raramente querem os mesmos), as teclas são da pessoa. *@
        <MudSwitch T="bool" Class="mt-3" Color="Color.Primary"
                   Value="SyncAll" ValueChanged="SetSyncAllAsync"
                   Disabled="@(_preferences is null)"
                   Label="Levar também gráficos, som e o resto das opções"/>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Vale para este PC. Num PC com isto desligado, só as teclas são trocadas com a conta.
        </MudText>
    </MudPaper>

    @if (Shell.Pairing?.Config is { } config)
    {
        <MudPaper Class="pa-6" Elevation="0" Outlined="true">
            <MudText Typo="Typo.subtitle1" GutterBottom="true">Servidor</MudText>
            <div class="tc-kv"><span>Nome</span><b>@Shell.ServerName</b></div>
            <div class="tc-kv"><span>Endereço</span><b>@config.ServerUrl</b></div>
        </MudPaper>
    }
</MudStack>
