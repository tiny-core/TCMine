@page "/modpacks"

<PageTitle>Modpacks</PageTitle>

<PageHeader Title="Modpacks" Subtitle="O catálogo publicado pelo servidor.">
    <MudButton Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.Refresh"
               Disabled="_loading"
               OnClick="LoadAsync">
        Atualizar
    </MudButton>
</PageHeader>

@if (_loading)
{
    <LoadingCards Count="6"/>
}
else if (_catalog?.Failed is true)
{
    @* Erro é diferente de vazio: um catálogo vazio é uma resposta, e uma falha
       de canal pede uma nova tentativa. Um estado só para os dois faria o
       jogador achar que o servidor não publicou nada. *@
    <EmptyState Icon="@Icons.Material.Filled.CloudOff"
                Title="Não foi possível carregar o catálogo"
                Description="@_catalog.Error">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">
            Tentar de novo
        </MudButton>
    </EmptyState>
}
else if (_catalog?.IsEmpty is true)
{
    <EmptyState Icon="@Icons.Material.Filled.Widgets"
                Title="Nenhum modpack disponível"
                Description="O catálogo é publicado pelo servidor e aparece aqui assim que a sua conta tiver acesso."/>
}
else if (_catalog is not null)
{
    <MudGrid>
        @foreach (var entrada in _catalog.Entries)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Class="tc-card tc-fade-in" Elevation="0" Outlined="true">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <MudAvatar Color="Color.Primary" Rounded="true">
                                @entrada.Modpack.Name[..1].ToUpperInvariant()
                            </MudAvatar>
                            <MudStack Spacing="0" Style="min-width:0;">
                                <MudText Typo="Typo.subtitle1">@entrada.Modpack.Name</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @entrada.Modpack.Slug
                                </MudText>
                            </MudStack>
                        </MudStack>

                        <MudStack Row="true" Spacing="2" Class="mt-3" Wrap="Wrap.Wrap">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                @entrada.Modpack.MinecraftVersion
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                @entrada.Modpack.Loader
                            </MudChip>

                            @* Só aparece quando existe servidor: um chip
                               "sem servidor" ocuparia espaço para dizer nada. *@
                            @if (entrada.HasServer)
                            {
                                <MudChip T="string" Size="Size.Small"
                                         Variant="Variant.Filled"
                                         Color="@(entrada.IsAnyServerRunning ? Color.Success : Color.Default)"
                                         Icon="@Icons.Material.Filled.Dns">
                                    @ServerLabel(entrada)
                                </MudChip>
                            }
                        </MudStack>

                        @if (!string.IsNullOrWhiteSpace(entrada.Modpack.Summary))
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
                                @entrada.Modpack.Summary
                            </MudText>
                        }

                        @* O botão vira a barra: durante a instalação o jogador
                           quer ver o andamento no lugar onde clicou, e não numa
                           faixa em outro canto da tela. *@
                        @if (_installing == entrada.Modpack.Id)
                        {
                            <MudProgressLinear Color="Color.Primary"
                                               Class="mt-4"
                                               Indeterminate="@(_progress?.Fraction is null)"
                                               Value="@((_progress?.Fraction ?? 0) * 100)"/>

                            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
                                @PhaseLabel(_progress)
                            </MudText>
                        }
                        else if (_installed.Contains(entrada.Modpack.Id))
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.CheckCircle"
                                       FullWidth="true"
                                       Class="mt-4"
                                       Disabled="true">
                                Instalado
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Download"
                                       FullWidth="true"
                                       Class="mt-4"
                                       Disabled="@(_installing is not null)"
                                       OnClick="@(() => InstallAsync(entrada.Modpack))">
                                Instalar
                            </MudButton>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code
{
    /// <summary>
    ///     O que está acontecendo agora, em palavras. Uma porcentagem sozinha não
    ///     distingue "baixando 400 MB" de "ligando 300 arquivos", e as duas fases
    ///     têm velocidades muito diferentes — sem o rótulo, a barra parece travar.
    /// </summary>
    private static string PhaseLabel(InstallProgress? progresso) => progresso?.Phase switch
    {
        InstallPhase.Planning => "A comparar com o que já está no disco…",
        InstallPhase.Downloading => $"A baixar {HumanSize.Bytes(progresso.BytesDone)} de {HumanSize.Bytes(progresso.BytesTotal)}",
        InstallPhase.Materializing => $"A instalar {progresso.FilesDone} de {progresso.FilesTotal} arquivos",
        InstallPhase.Cleaning => "A remover o que sobrou da versão anterior…",
        InstallPhase.Done => "Pronto.",
        _ => "A preparar…"
    };
}
