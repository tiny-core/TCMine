@* Escolher que versão instalar.

   Lista e não um MudSelect: a data de publicação e a versão do loader são o que
   decide a escolha de quem procura uma versão específica — normalmente porque um
   servidor está fixado nela — e escondê-las atrás de um clique tornaria o
   seletor decorativo. *@

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4"/>
        }
        else if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                @_error
            </MudAlert>
        }
        else if (_versions.Count is 0)
        {
            @* Distinto de falha: um pack sem nenhuma versão publicada é estado
               legítimo, e dizer "erro" mandaria o jogador procurar problema onde
               não há. *@
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Este modpack ainda não tem versões publicadas.
            </MudText>
        }
        else
        {
            <MudList T="Guid" @bind-SelectedValue="_selected" Dense="true">
                @foreach (var version in _versions)
                {
                    <MudListItem T="Guid" Value="@version.Id">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            @* Parênteses obrigatórios: "v@algo.Coisa" cai na
                               heurística de e-mail do Razor e sai literal na
                               tela, sem nenhum erro de compilação a avisar. *@
                            <MudText Typo="Typo.body1">v@(version.Version)</MudText>

                            @if (version.Id == _versions[0].Id)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success"
                                         Variant="Variant.Text">
                                    mais recente
                                </MudChip>
                            }
                        </MudStack>

                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @version.PublishedAt.ToLocalTime().ToString("d MMM yyyy")
                            · loader @version.LoaderVersion
                        </MudText>
                    </MudListItem>
                }
            </MudList>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_selected == Guid.Empty)"
                   OnClick="Confirmar">
            Instalar
        </MudButton>
    </DialogActions>
</MudDialog>
