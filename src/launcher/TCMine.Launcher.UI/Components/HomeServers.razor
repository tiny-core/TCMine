@* Onde jogar. A lista de servidores é por Membership (ver ListAccessibleServers
   no servidor) — uma conta nova não enxerga nenhum até resgatar um convite, e
   por isso o link para resgatar fica aqui, não escondido numa tela à parte. *@

<MudPaper Class="pa-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.overline" Class="mud-text-secondary">Onde jogar</MudText>

    @if (Servers.Count > 0)
    {
        <MudStack Spacing="3" Class="mt-3">
            @foreach (var server in Servers)
            {
                <div>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <ServerStatusChip Status="server.Status"/>
                        <MudText Typo="Typo.body2" Class="tc-side-name">@server.Name</MudText>
                    </MudStack>

                    @* Selecionável: entrar num servidor é copiar este endereço
                       para o jogo, e um texto que não se consegue marcar obriga
                       a digitá-lo à mão. *@
                    <MudText Typo="Typo.caption" Class="mud-text-secondary tc-side-address">
                        @server.ConnectAddress
                    </MudText>
                </div>
            }
        </MudStack>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
            Nenhum servidor ainda. Se alguém te convidou, resgate o código abaixo.
        </MudText>
    }

    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.CardGiftcard"
               Class="mt-3" OnClick="@(() => OnRedeemInvite.InvokeAsync())">
        Tenho um convite
    </MudButton>
</MudPaper>
