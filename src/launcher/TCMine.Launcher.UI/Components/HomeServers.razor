@using TCMine.Contracts.Servers
@* Onde jogar. Todo servidor aparece — mesmo o que o jogador ainda não pode
   entrar (ver ListAccessibleServers no servidor): é o que torna "Pedir
   acesso" possível, e o link para resgatar um convite fica aqui, não
   escondido numa tela à parte. *@

<MudPaper Class="pa-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.overline" Class="mud-text-secondary">Onde jogar</MudText>

    @if (Servers.Count > 0)
    {
        <MudStack Spacing="3" Class="mt-3">
            @foreach (var server in Servers)
            {
                <div>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <ServerStatusChip Status="server.Status"/>
                        <MudText Typo="Typo.body2" Class="tc-side-name">@server.Name</MudText>
                    </MudStack>

                    @* Lotação: não é dado sensível como o endereço (que só sai
                       com acesso concedido), então aparece para qualquer um —
                       é o mesmo número que a página pública já mostra. *@
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @server.OnlinePlayers / @server.MaxPlayers jogadores
                    </MudText>

                    @if (server.AccessState is ServerAccessState.Granted)
                    {
                        @* Selecionável: quem quiser adicioná-lo à mão no jogo
                           copia daqui, sem ter de o digitar. *@
                        <MudText Typo="Typo.caption" Class="mud-text-secondary tc-side-address">
                            @server.ConnectAddress
                        </MudText>

                        @* Desligado com o motivo à vista, nunca escondido: um
                           servidor parado continua na lista, e o jogador tem de
                           saber porque não dá para entrar agora. *@
                        <MudTooltip Text="@WhyCannotJoin(server)" Disabled="@(WhyCannotJoin(server) is null)">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       Class="mt-1"
                                       StartIcon="@(NeedsUpdate(server)
                                                      ? Icons.Material.Filled.SystemUpdateAlt
                                                      : Icons.Material.Filled.Login)"
                                       Disabled="@(WhyCannotJoin(server) is not null)"
                                       OnClick="@(() => OnJoin.InvokeAsync(server))">
                                @if (Joining == server.Id)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                                }
                                @(NeedsUpdate(server) ? "Atualizar e entrar" : "Entrar")
                            </MudButton>
                        </MudTooltip>
                    }
                    else if (EstaPendente(server))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Pedido enviado — aguardando aprovação
                        </MudText>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   Disabled="_pedindo.Contains(server.Id)"
                                   OnClick="@(() => PedirAcessoAsync(server))">
                            @if (_pedindo.Contains(server.Id))
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                            }
                            Pedir acesso
                        </MudButton>
                    }
                </div>
            }
        </MudStack>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
            Nenhum servidor ainda. Se alguém te convidou, resgate o código abaixo.
        </MudText>
    }

    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.CardGiftcard"
               Class="mt-3" OnClick="@(() => OnRedeemInvite.InvokeAsync())">
        Tenho um convite
    </MudButton>
</MudPaper>
