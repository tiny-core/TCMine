# Copie para .env e ajuste. O compose lê este arquivo automaticamente.

# Raiz dos dados NO HOST. É montada no MESMO caminho dentro do container —
# o daemon do Docker interpreta os caminhos das instâncias como caminhos do
# host, então os dois lados precisam concordar. Use caminho absoluto.
TCMINE_ROOT=/opt/tcmine

# GID do grupo dono de /var/run/docker.sock. Descubra com:
#   getent group docker | cut -d: -f3
DOCKER_GID=999

# Endereço público por onde o jogador alcança este servidor. Obrigatório fora
# de Development: é o que vai no tcmine.json e no feed do launcher.
TCMINE_PUBLIC_URL=https://tcmine.exemplo.com

TCMINE_NAME=TCMine Server
TCMINE_PORT=8080

# Client ID da app Azure usada no login com a Microsoft.
#
# OPCIONAL: é apenas uma semente. O lugar normal de o definir é a tela de
# Configurações do painel, aba Login — registar a app no Entra ID acontece
# DEPOIS do deploy, e o servidor sobe sem ele de propósito para você conseguir
# chegar ao painel e configurá-lo. Enquanto estiver vazio nos dois lados, o
# launcher recusa o pareamento pedindo para avisar o administrador.
#
# Se preencher aqui, o valor do painel continua a ter precedência.
TCMINE_AZURE_CLIENT_ID=

# Deixe vazio para o SQLite sob TCMINE_ROOT. Só preencha para Postgres.
TCMINE_DB_CONNECTION=

# Sqlite serve bem para uma instalação pequena. Para Postgres, suba o perfil
# (docker compose --profile postgres up -d) e troque as duas linhas abaixo:
#   TCMINE_DB_PROVIDER=Postgres
#   TCMINE_DB_CONNECTION=Host=postgres;Database=tcmine;Username=tcmine;Password=...
TCMINE_DB_PROVIDER=Sqlite

# POSTGRES_PASSWORD=troque-isto
