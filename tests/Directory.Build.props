<Project>

    <!--
      Importa o Directory.Build.props da raiz antes de adicionar o que é
      específico de teste. Sem esta linha, o MSBuild para no arquivo mais
      próximo e os projetos de teste perderiam Nullable, TargetFramework etc.
    -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Shouldly"/>
    </ItemGroup>

    <!-- Evita repetir os mesmos usings no topo de cada arquivo de teste -->
    <ItemGroup>
        <Using Include="Xunit"/>
        <Using Include="Shouldly"/>
    </ItemGroup>

</Project>