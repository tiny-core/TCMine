<Project Sdk="Microsoft.NET.Sdk">

  <!--
      Referencia todos os projetos que participam das regras. Sem a referência,
      o assembly não é carregado e o teste passaria sem verificar nada — falso
      positivo silencioso, o pior tipo.
  -->
  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules"/>
  </ItemGroup>

  <!--
      Só server e shared: as regras do launcher moraram aqui antes e se
      mudaram para TCMine.Launcher.Architecture.Tests, porque este projeto
      precisa continuar compilando sem o launcher (§0/§12 do CLAUDE.md — o
      launcher saiu do CI, e uma referência aqui traria a compilação dele de
      volta pela porta dos fundos).
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\shared\TCMine.Contracts\TCMine.Contracts.csproj"/>
    <ProjectReference Include="..\..\src\server\TCMine.Server.Domain\TCMine.Server.Domain.csproj"/>
    <ProjectReference Include="..\..\src\server\TCMine.Server.Application\TCMine.Server.Application.csproj"/>
  </ItemGroup>


  <!--
      Nomes de método de teste em PT-BR com underscore são idiomáticos aqui (o
      CLAUDE.md permite explicitamente). Fica no csproj e não no .editorconfig
      porque a resolução do glob "tests/**" se mostrou instável entre builds —
      a regra reaparecia em arquivos diferentes a cada compilação.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

</Project>
