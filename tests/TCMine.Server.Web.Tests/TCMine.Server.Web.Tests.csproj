<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing"/>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\server\TCMine.Server.Web\TCMine.Server.Web.csproj"/>

    <!--
        O CLIENTE do launcher, para o teste de contrato poder exercer os dois
        lados de verdade. A regra "servidor não referencia launcher" vale para
        os assemblies de produção, e é ela que os testes de arquitetura
        verificam; aqui a referência existe justamente para provar que as duas
        metades encaixam.
    -->
    <ProjectReference Include="..\..\src\launcher\TCMine.Launcher.Infrastructure\TCMine.Launcher.Infrastructure.csproj"/>

    <!--
        Referencia o projeto de testes da Application só pelos fakes base
        (Fake*Base.cs). Duplicar aqui um IServerRepository inteiro significaria
        dois lugares para atualizar a cada membro novo na porta — exatamente o
        que as bases existem para evitar.
    -->
    <ProjectReference Include="..\TCMine.Server.Application.Tests\TCMine.Server.Application.Tests.csproj"/>
  </ItemGroup>

  <!-- Nomes de método de teste em PT-BR com underscore; ver Application.Tests. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

</Project>
